---
// Client-side island — sets cookie tension_ag=1 on confirm
---

<div id="age-gate-overlay" class="fixed inset-0 z-50 flex items-center justify-center p-6" style="background-color: rgba(26,20,16,0.95);">
  <div class="max-w-md w-full rounded-xl p-10 text-center" style="background-color: var(--color-warm-50);">
    <h2 class="font-serif text-2xl font-semibold mb-3" style="color: var(--color-matte-black);">Adults only</h2>
    <p class="text-base mb-8 leading-relaxed" style="color: var(--color-text-muted);">
      This section contains content for adults 18 and over. By continuing, you confirm that you are at least 18 years old.
    </p>
    <div class="flex flex-col gap-3">
      <button
        id="age-confirm-btn"
        class="w-full py-4 rounded font-semibold text-base"
        style="background-color: var(--color-burgundy); color: var(--color-cream);"
      >
        I am 18 or older — Continue
      </button>
      <a href="/" class="text-sm" style="color: var(--color-text-muted);">Take me back</a>
    </div>
  </div>
</div>

<script>
document.getElementById('age-confirm-btn')?.addEventListener('click', () => {
  const expires = new Date();
  expires.setFullYear(expires.getFullYear() + 1);
  document.cookie = `tension_ag=1; expires=${expires.toUTCString()}; path=/; SameSite=Lax`;
  document.getElementById('age-gate-overlay')?.remove();

  // Redirect to intended destination if stored
  const dest = sessionStorage.getItem('age_gate_dest');
  if (dest) {
    sessionStorage.removeItem('age_gate_dest');
    window.location.href = dest;
  }
});
</script>
