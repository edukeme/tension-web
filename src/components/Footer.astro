---
const year = new Date().getFullYear();
---

<footer style="background: #0A0A0A; border-top: 1px solid #1E1E1E;">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="flex flex-col md:flex-row justify-between gap-10">

      <div class="max-w-xs">
        <p class="font-serif text-lg font-semibold tracking-[0.12em] uppercase mb-3" style="color: #EBEBEB;">Tension</p>
        <p class="text-sm leading-relaxed" style="color: #555;">
          Intentional intimacy coaching. For couples who want more than fine.
        </p>
      </div>

      <div class="flex gap-16 text-sm">
        <div>
          <p class="font-semibold mb-4 text-xs tracking-widest uppercase" style="color: #444; letter-spacing: 0.14em;">Products</p>
          <ul class="space-y-2.5">
            {[
              ['/21-scenes', '21 Scenes'],
              ['/brat-playbook', 'Brat Playbook'],
              ['/verbal-arsenal', 'Verbal Arsenal'],
              ['/negotiation-workbook', 'Negotiation Workbook'],
              ['/erotic-tales', 'Erotic Tales'],
              ['/bundle', 'The Bundle'],
            ].map(([href, label]) => (
              <li>
                <a href={href} style="color: #888;"
                  onmouseover="this.style.color='#EBEBEB'"
                  onmouseout="this.style.color='#666'"
                >{label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="font-semibold mb-4 text-xs tracking-widest uppercase" style="color: #444; letter-spacing: 0.14em;">Resources</p>
          <ul class="space-y-2.5">
            {[
              ['/free-checklist', 'Free Checklist'],
              ['/blog', 'Blog'],
              ['/terms', 'Terms'],
              ['/privacy', 'Privacy'],
            ].map(([href, label]) => (
              <li>
                <a href={href} style="color: #888;"
                  onmouseover="this.style.color='#EBEBEB'"
                  onmouseout="this.style.color='#666'"
                >{label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>

    <div class="mt-12 pt-6 flex flex-col md:flex-row justify-between items-center gap-2 text-xs"
         style="border-top: 1px solid #1A1A1A; color: #444;">
      <p>© {year} Tension. For adults 18+.</p>
      <p>Educational content only. Not a substitute for professional support.</p>
    </div>
  </div>
</footer>
