---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const CATEGORY_LABELS: Record<string, string> = {
  'kink-101': 'Kink 101',
  'dynamics': 'Dynamics',
  'scenes': 'Scenes',
  'aftercare': 'Aftercare',
  'tests': 'Tests & Quizzes',
};

const CATEGORY_GRADIENT: Record<string, string> = {
  'tests':    'linear-gradient(135deg, #3A2A2E 0%, #252525 100%)',
  'kink-101': 'linear-gradient(135deg, #2E2A3A 0%, #252525 100%)',
  'dynamics': 'linear-gradient(135deg, #2A343A 0%, #252525 100%)',
  'scenes':   'linear-gradient(135deg, #343A2A 0%, #252525 100%)',
  'aftercare':'linear-gradient(135deg, #2A3A34 0%, #252525 100%)',
};

const categories = [...new Set(posts.map(p => p.data.category))];

function readTime(wordcount: number) {
  return `${Math.ceil(wordcount / 220)} min read`;
}
---

<BaseLayout
  title="Blog — Power Dynamics & Intentional Intimacy"
  description="Plain-language guides on D/s dynamics, BDSM basics, scene planning, aftercare, and intentional intimacy. Written by Mr. D."
>

  <!-- Blog hero -->
  <div style="background: linear-gradient(160deg, #110608 0%, #0A0A0A 60%); border-bottom: 1px solid #1E1E1E;">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="flex items-center gap-3 mb-8">
        <span class="block w-8 h-px" style="background: #D4213D;"></span>
        <span class="text-xs font-semibold tracking-widest uppercase" style="color: #D4213D; letter-spacing: 0.18em;">Tension</span>
      </div>
      <h1 class="font-serif font-semibold mb-4" style="color: #EBEBEB; font-size: clamp(2.2rem, 5vw, 3.5rem); letter-spacing: -0.02em; max-width: 16ch;">
        The Tension Blog
      </h1>
      <p style="color: #888; max-width: 44ch;" class="text-base leading-relaxed">
        Plain answers to the questions most people Google at 11pm.
      </p>
    </div>
  </div>

  <!-- Category filters — sticky -->
  <div style="background: #0A0A0A; border-bottom: 1px solid #1A1A1A; position: sticky; top: 0; z-index: 20;">
    <div class="max-w-5xl mx-auto px-6 py-4 flex flex-wrap gap-2">
      <button
        data-filter="all"
        class="filter-btn px-4 py-1.5 text-xs font-semibold tracking-widest uppercase transition-colors"
        style="background: #D4213D; color: #fff; letter-spacing: 0.12em;"
      >
        All
      </button>
      {categories.map(cat => (
        <button
          data-filter={cat}
          class="filter-btn px-4 py-1.5 text-xs font-medium tracking-widest uppercase transition-colors"
          style="background: transparent; color: #888; border: 1px solid #2A2A2A; letter-spacing: 0.12em;"
          onmouseover="if(!this.classList.contains('active')) { this.style.color='#EBEBEB'; this.style.borderColor='#555'; }"
          onmouseout="if(!this.classList.contains('active')) { this.style.color='#888'; this.style.borderColor='#2A2A2A'; }"
        >
          {CATEGORY_LABELS[cat] ?? cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Posts grid -->
  <div style="background: #0A0A0A; min-height: 60vh;">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="posts-grid">
        {posts.map((post) => (
          <article
            data-category={post.data.category}
            class="post-card group flex flex-col transition-all duration-300 rounded-2xl overflow-hidden"
            style="background: #1C1C1E; border: 1px solid rgba(255, 255, 255, 0.08);"
            onmouseover="this.style.borderColor='rgba(212,33,61,0.5)'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 24px rgba(0,0,0,0.5)'"
            onmouseout="this.style.borderColor='rgba(255, 255, 255, 0.08)'; this.style.transform='translateY(0)'; this.style.boxShadow='none'"
          >
            <!-- Card Image Preview -->
            <div class="h-44 overflow-hidden relative bg-[#0A0A0A]">
              <div
                class="w-full h-full bg-cover bg-center transition-all duration-500 group-hover:scale-105"
                style={`
                  background-image: linear-gradient(to top, rgba(28, 28, 30, 0.95) 0%, rgba(28, 28, 30, 0.2) 100%), url('/images/blog_${post.data.slug}.png');
                  filter: grayscale(100%) sepia(100%) hue-rotate(345deg) saturate(2.5) contrast(1.5) brightness(0.65);
                `}
              ></div>
              <!-- Pill tag -->
              <span
                class="absolute bottom-4 left-4 text-xs font-semibold px-2.5 py-1 uppercase tracking-widest rounded-full z-10"
                style="background: rgba(212,33,61,0.15); color: #D4213D; border: 1px solid rgba(212,33,61,0.3); letter-spacing: 0.1em; font-size: 9px;"
              >
                {CATEGORY_LABELS[post.data.category] ?? post.data.category}
              </span>
            </div>

            <!-- Card body -->
            <div class="flex flex-col flex-1 p-6">
              <h2 class="font-serif text-lg font-medium leading-snug mb-3 flex-1">
                <a
                  href={`/blog/${post.data.slug}/`}
                  style="color: #EBEBEB; transition: color 0.2s;"
                  onmouseover="this.style.color='#D4213D'"
                  onmouseout="this.style.color='#EBEBEB'"
                >
                  {post.data.title}
                </a>
              </h2>
              <p class="text-sm leading-relaxed mb-6" style="color: #999; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {post.data.meta_description}
              </p>
              <div class="flex items-center justify-between text-xs pt-4" style="color: #666; border-top: 1px solid rgba(255,255,255,0.06);">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span>{readTime(post.data.wordcount)}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

</BaseLayout>

<style>
  .filter-btn.active {
    background: #D4213D !important;
    color: #fff !important;
    border-color: #D4213D !important;
  }
</style>

<script>
const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
const cards = document.querySelectorAll<HTMLElement>('.post-card');

buttons.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter;

    buttons.forEach(b => {
      b.classList.remove('active');
      b.style.background = 'transparent';
      b.style.color = '#888';
      b.style.borderColor = '#2A2A2A';
    });
    btn.classList.add('active');
    btn.style.background = '#D4213D';
    btn.style.color = '#fff';
    btn.style.borderColor = '#D4213D';

    cards.forEach(card => {
      const show = filter === 'all' || card.dataset.category === filter;
      card.style.display = show ? 'flex' : 'none';
    });
  });
});
</script>
