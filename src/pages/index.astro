---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCaptureForm from '@/components/EmailCaptureForm.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const products = await getCollection('products');
const productBySlug = (slug: string) => products.find(product => product.data.slug === slug);
const guides = [
  { slug: 'negotiation-workbook', title: 'The Negotiation Workbook', description: 'An 8-section fill-in workbook. From “we’ve been thinking about this” to a real D/s structure in one sitting.', price: '€9.90', image: '/images/lp/tension-guide-negotiation.png', label: 'Conversation' },
  { slug: '21-scenes', title: '21 Scenes That Will Drive You Crazy', description: '21 ready-to-run scene blueprints — beginner to advanced, with dialogue and aftercare.', price: '€9.90', image: '/images/lp/tension-guide-scenes.png', label: 'Practice' },
  { slug: 'brat-playbook', title: 'The Brat Submissive Playbook', description: 'The complete brat dynamics guide — for dominants who need to win, and submissives who need to be understood.', price: '€14.90', image: '/images/lp/tension-guide-brat.png', label: 'Dynamics' },
].map(guide => ({ ...guide, product: productBySlug(guide.slug) }));
---

<BaseLayout title="Intentional Intimacy Coaching for Couples" description="Tension gives couples and singles the language, structure, and consent-first tools to explore power dynamics with care." canonical="/">
  <main class="lp-dark">
    <section class="tension-hero relative isolate min-h-[92svh] overflow-hidden bg-black">
      <img src="/images/lp/tension-hero-couple.png" alt="Two adults sharing a quiet, affectionate moment together" class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,.28),rgba(0,0,0,.58)_55%,#000_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_10%,rgba(0,0,0,.42)_100%)]"></div>
      <div class="relative z-10 mx-auto flex min-h-[92svh] max-w-5xl items-center justify-center px-6 py-28 text-center"><div class="max-w-3xl">
        <p class="eyebrow mb-7 text-[#C9952E]">Tension · intentional intimacy</p>
        <h1 class="font-serif text-[clamp(3.1rem,8vw,7rem)] leading-[.92] tracking-[-.04em] text-[#F4F0E8]">The relationship<br /><em class="text-[#C9952E]">behind the scene.</em></h1>
        <p class="mx-auto mt-8 max-w-2xl text-base leading-7 text-[#F4F0E8]/80 md:text-lg">For couples and singles who want more intention, more language, and more trust in the way they explore.</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"><a class="btn-primary" href="/free-checklist">Get the free couples checklist →</a><a class="btn-secondary" href="#how-it-works">See how Tension works</a></div>
        <p class="mt-8 text-[10px] font-semibold uppercase tracking-[.24em] text-[#F4F0E8]/65">Private by default · Consent-first · Written for adults</p>
      </div></div>
    </section>

    <section class="border-y border-[#C9952E]/50 bg-black" aria-label="Tension principles"><div class="mx-auto grid max-w-5xl grid-cols-1 md:grid-cols-3">
      <article class="principle-card"><div class="gold-icon" aria-hidden="true">▢</div><h2>Language</h2><em>Say what you want without making it weird.</em></article>
      <article class="principle-card"><div class="gold-icon" aria-hidden="true">▦</div><h2>Structure</h2><em>Turn a fantasy into a conversation and a plan.</em></article>
      <article class="principle-card"><div class="gold-icon" aria-hidden="true">♡</div><h2>Care</h2><em>Keep consent, limits, and aftercare in the frame.</em></article>
    </div></section>

    <section class="bg-black px-6 py-28 text-center"><div class="mx-auto max-w-3xl"><p class="eyebrow text-[#A61E2D]">A better starting point</p><h2 class="section-title mt-5">You do not need a new identity. You need a clearer conversation.</h2><div class="gold-rule mx-auto my-9 max-w-xs"></div><div class="mx-auto max-w-2xl space-y-5 text-base leading-8 text-[#F4F0E8]/75"><p>Most people find Tension after the search results, the awkward half-conversation, or the moment one partner says: “I want to try something, but I do not know how.”</p><p>Start with the relationship you already have. Explore at the pace that fits your life. Keep what creates connection; leave what does not.</p></div></div></section>

    <section id="how-it-works" class="bg-black px-6 pb-28"><div class="mx-auto max-w-5xl"><p class="eyebrow text-center text-[#A61E2D]">How it works</p><div class="how-rail mt-14"><article><span>01</span><div><h3>Find the words</h3><p>Use plain-language prompts to name desire, curiosity, limits, and uncertainty.</p></div></article><div class="rail-line" aria-hidden="true"></div><article><span>02</span><div><h3>Build the frame</h3><p>Choose the level of structure, roles, rituals, and safety tools that work for you.</p></div></article><div class="rail-line" aria-hidden="true"></div><article><span>03</span><div><h3>Explore with care</h3><p>Plan a first experiment, keep checking in, and make room for what happens afterward.</p></div></article></div></div></section>

    <section id="checklist" class="bg-black px-6 pb-28"><div class="mx-auto grid max-w-5xl items-center gap-10 border border-[#C9952E]/80 p-8 md:grid-cols-[1.15fr_.55fr_1fr] md:p-12"><div><p class="eyebrow text-[#A61E2D]">Start with one honest conversation</p><h2 class="mt-4 font-serif text-3xl text-[#F4F0E8]">The Couples Kink Discovery Checklist</h2><p class="mt-2 font-serif text-lg italic text-[#C9952E]">90 activities across seven categories, with five answers that make “maybe” safe to say.</p><ul class="checklist-list mt-7"><li>Complete it together, not as a test of compatibility.</li><li>Separate curiosity from commitment.</li><li>Use your overlap as a starting point, not a score.</li></ul></div><div class="text-center"><strong class="block font-serif text-8xl font-normal leading-none text-[#C9952E]">90</strong><span class="text-sm font-semibold tracking-[.3em] text-[#C9952E]">SECONDS</span></div><div><h3 class="font-serif text-2xl text-[#F4F0E8]">Get the checklist privately.</h3><p class="mt-2 text-sm leading-6 text-[#F4F0E8]/70">No public profile. No sales call. Just the PDF and a useful place to begin.</p><div class="mt-6"><EmailCaptureForm buttonLabel="Send me the checklist →" /></div><small class="mt-3 block text-center text-xs text-[#F4F0E8]/55">We will only email the address you provide. Unsubscribe anytime.</small></div></div></section>

    <section id="guides" class="bg-black px-6 pb-28"><div class="mx-auto max-w-5xl"><div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow text-[#A61E2D]">Go deeper when you are ready</p><h2 class="section-title mt-5 max-w-xl">Tools for the dynamic you are building.</h2></div><a class="btn-secondary" href="/#products">Browse all resources →</a></div><div class="grid gap-5 md:grid-cols-3">{guides.map(guide => (<a class="guide-card" href={`/${guide.slug}/`}><img src={guide.image} alt="" loading="lazy" /><div class="guide-overlay"></div><div class="relative z-10 flex h-full flex-col justify-end p-6"><p class="eyebrow text-[#A61E2D]">{guide.label}</p><h3 class="mt-3 font-serif text-2xl text-[#F4F0E8]">{guide.title}</h3><p class="mt-3 text-sm leading-6 text-[#F4F0E8]/75">{guide.description}</p><p class="mt-6 flex justify-between border-t border-[#C9952E]/50 pt-4 text-sm font-semibold text-[#C9952E]"><span>{guide.price}</span><span>Learn more →</span></p></div></a>))}</div></div></section>

    <section class="bg-black px-6 pb-28"><div class="mx-auto max-w-5xl"><p class="eyebrow mb-6 text-center text-[#A61E2D]">Visual direction</p><h2 class="section-title text-center">Two ways to make the first impression.</h2><p class="mx-auto mt-5 max-w-2xl text-center text-[#F4F0E8]/70">The LP currently uses Variation A. Variation B is ready if you want the brand to feel more architectural and symbolic.</p><div class="mt-12 grid gap-5 md:grid-cols-2"><a class="direction-card" href="/blog/"><img src="/images/lp/tension-direction-editorial.png" alt="Editorial intimacy: a couple in a quiet private moment" loading="lazy" /><span><strong>Variation A — Editorial intimacy</strong><em>Human, warm, relationship-first. Best for leading with trust and emotional safety.</em><small>Current LP hero → Journal</small></span></a><a class="direction-card" href="/blog/topic/tools-guides/"><img src="/images/lp/tension-direction-tactile.png" alt="Tactile structure: abstract objects representing a private ritual" loading="lazy" /><span><strong>Variation B — Tactile structure</strong><em>Abstract, private, symbolic. Best for leading with design, rituals, and chosen power.</em><small>Alternate direction → Tools &amp; guides</small></span></a></div></div></section>

    <section class="bg-black px-6 py-28 text-center"><div class="mx-auto max-w-3xl"><p class="eyebrow text-[#A61E2D]">You can start without knowing the label.</p><h2 class="section-title mt-5">You only need a next conversation.</h2><a class="btn-primary mt-9" href="/free-checklist">Get the free checklist →</a></div></section>
  </main>
</BaseLayout>

<style>
  .lp-dark { background:#000; color:#F4F0E8; }
  .eyebrow { font:600 10px/1 Inter,sans-serif; letter-spacing:.24em; text-transform:uppercase; }
  .btn-primary { display:inline-flex; align-items:center; justify-content:center; background:#A61E2D; color:#F4F0E8; padding:.9rem 1.35rem; border:1px solid #A61E2D; transition:background .2s,border-color .2s,transform .2s; }
  .btn-primary:hover { background:#C9952E; border-color:#C9952E; color:#000; transform:translateY(-2px); }
  .btn-secondary { display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(201,149,46,.7); color:#C9952E; padding:.9rem 1.35rem; transition:background .2s,color .2s; }
  .btn-secondary:hover { background:#C9952E; color:#000; }
  .gold-rule { height:1px; background:linear-gradient(90deg,transparent,#C9952E,transparent); }
  .principle-card { padding:52px 32px; text-align:center; border-right:1px solid rgba(201,149,46,.5); }
  .principle-card:last-child { border-right:0; }
  .gold-icon { color:#C9952E; font-size:35px; line-height:1; margin-bottom:17px; }
  .principle-card h2 { font:600 1.7rem/1.1 Fraunces,serif; margin-bottom:7px; }
  .principle-card em { color:#C9952E; font:italic 1rem/1.5 Fraunces,serif; }
  .principle-card p { color:rgba(244,240,232,.75); font:1rem/1.5 Fraunces,serif; margin:11px auto 0; max-width:22ch; }
  .section-title { color:#F4F0E8; font:600 clamp(2.4rem,5vw,4.4rem)/.98 Fraunces,serif; letter-spacing:-.035em; }
  .how-rail { display:grid; grid-template-columns:1fr minmax(40px,.35fr) 1fr minmax(40px,.35fr) 1fr; align-items:center; gap:18px; }
  .how-rail article { display:flex; gap:18px; align-items:start; }
  .how-rail article>span { color:#C9952E; font:400 3.8rem/.8 Fraunces,serif; }
  .how-rail h3 { color:#F4F0E8; font:600 1.35rem/1.1 Fraunces,serif; }
  .how-rail p { color:rgba(244,240,232,.7); font-size:.85rem; line-height:1.55; margin-top:9px; }
  .rail-line { height:1px; background:#C9952E; opacity:.65; }
  .checklist-list { display:grid; gap:10px; color:rgba(244,240,232,.76); font-size:.9rem; line-height:1.5; }
  .checklist-list li::before { content:'✓'; color:#C9952E; margin-right:10px; }
  .guide-card,.direction-card { position:relative; overflow:hidden; border:1px solid rgba(201,149,46,.8); background:#000; }
  .guide-card { min-height:360px; display:block; }
  .guide-card img,.direction-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:brightness(.48) saturate(.55); transition:transform .4s; }
  .guide-card:hover img,.direction-card:hover img { transform:scale(1.04); }
  .guide-overlay { position:absolute; inset:0; background:linear-gradient(0deg,rgba(0,0,0,.95),rgba(0,0,0,.12) 80%); }
  .direction-card { min-height:230px; display:block; }
  .direction-card::after { content:''; position:absolute; inset:0; background:linear-gradient(0deg,rgba(0,0,0,.95),rgba(0,0,0,.12)); }
  .direction-card>span { position:absolute; z-index:1; inset:auto 26px 24px; display:grid; gap:7px; }
  .direction-card strong { color:#F4F0E8; font:600 1.55rem/1.1 Fraunces,serif; }
  .direction-card em { color:#C9952E; font:italic 1rem/1.35 Fraunces,serif; }
  .direction-card small { color:rgba(244,240,232,.7); font-size:.7rem; letter-spacing:.14em; text-transform:uppercase; }
  a:focus-visible,input:focus-visible,button:focus-visible { outline:2px solid #C9952E; outline-offset:3px; }
  @media (max-width:760px) { .principle-card{border-right:0;border-bottom:1px solid rgba(201,149,46,.5)} .principle-card:last-child{border-bottom:0} .how-rail{grid-template-columns:1fr;gap:24px} .rail-line{width:1px;height:30px;margin-left:28px} }
  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition-duration:.01ms!important; animation-duration:.01ms!important; } }
</style>
