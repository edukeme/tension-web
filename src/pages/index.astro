---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  ArrowRight,
  BookOpen,
  Check,
  Mail,
  MessageCircle,
  ShieldCheck,
  Sparkles,
} from '@lucide/astro';

export const prerender = true;

const principles = [
  {
    number: '01',
    title: 'Say what you want',
    copy: 'Find language for desire, hesitation, boundaries, and the things you have only hinted at.',
  },
  {
    number: '02',
    title: 'Explore without guessing',
    copy: 'Use practical checklists, scripts, and scene frameworks instead of improvising under pressure.',
  },
  {
    number: '03',
    title: 'Make trust part of the tension',
    copy: 'Turn clarity, consent, and anticipation into part of what makes the experience compelling.',
  },
  {
    number: '04',
    title: 'Bring the connection back with you',
    copy: 'Reflect, reconnect, and carry what you learn about each other beyond a single scene.',
  },
];

const method = [
  ['Talk honestly', 'Name desire and hesitation without turning curiosity into pressure.'],
  ['Choose together', 'Curiosity is an invitation—not consent or obligation.'],
  ['Prepare properly', 'Agree on limits, safewords, the frame, and what you need afterward.'],
  ['Play with attention', 'Stay responsive. The plan is a container, not a performance.'],
  ['Come back together', 'Use aftercare and reflection to understand what worked and what comes next.'],
];

const scenes = [
  {
    level: 'Beginner',
    number: 'I',
    title: 'First Explorations',
    href: '/7-scenes-first-explorations/',
    copy: 'Seven complete D/s blueprints for turning curiosity into your first structured experiences.',
    detail: 'Presence · language · surrender',
  },
  {
    level: 'Intermediate',
    number: 'II',
    title: 'The Deep Game',
    href: '/7-scenes-deep-game/',
    copy: 'Roleplay, anticipation, resistance, impact, and longer psychological frames.',
    detail: 'Depth · resistance · attention',
  },
  {
    level: 'Advanced',
    number: 'III',
    title: 'The Edge',
    href: '/7-scenes-the-edge/',
    copy: 'Long-form experiences for couples with established trust and a working D/s dynamic.',
    detail: 'Duration · trust · intensity',
  },
];

const guides = [
  {
    eyebrow: 'Tension Talk',
    title: 'The Kink Conversation Workbook',
    href: '/negotiation-workbook/',
    copy: 'Turn “we’ve been thinking about this” into a real, shared structure.',
    image: '/images/lp/tension-guide-negotiation.png',
  },
  {
    eyebrow: 'Tension Play',
    title: 'The Brat Dynamics Playbook',
    href: '/brat-playbook/',
    copy: 'Understand playful resistance—and create a dynamic that works for both of you.',
    image: '/images/lp/tension-guide-brat.png',
  },
  {
    eyebrow: 'Tension Play',
    title: 'The Verbal Arsenal',
    href: '/verbal-arsenal/',
    copy: 'Specific language for presence, tension, praise, correction, and control.',
    image: '/images/lp/tension-guide-language-v3.png',
  },
];

const journal = [
  {
    href: '/blog/how-to-start-bdsm-as-a-couple/',
    title: 'How to start BDSM as a couple',
    copy: 'The conversation, the first agreement, and the first experience—without making it weird.',
  },
  {
    href: '/blog/can-be-great-boyfriend-and-dominant/',
    title: 'Can you be a great partner and a good dominant?',
    copy: 'Why presence matters more than performing a version of authority.',
  },
  {
    href: '/blog/bdsm-couples-test/',
    title: 'The BDSM couples test',
    copy: 'Questions that reveal what excites you, what worries you, and where you meet.',
  },
];
---

<BaseLayout
  title="Kink-Informed Relationship Education for Couples"
  description="Practical, erotic relationship education for couples exploring kink, BDSM, D/s, and consensual power dynamics."
  canonical="/"
  ogImage="/images/lp/tension-hero-v4.jpg"
  hideChrome={true}
>
  <div class="landing">
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Tension home">TENSION</a>
        <nav aria-label="Primary navigation">
          <a href="#method">Our method</a>
          <a href="#mrd">Mr. D</a>
          <a href="#playbooks">Playbooks</a>
          <a href="/blog/">Journal</a>
        </nav>
        <a class="button button--small" href="/free-checklist/">Discover what you both want</a>
      </div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <img
        src="/images/lp/tension-hero-v4.jpg"
        alt="An adult couple sharing a quiet, anticipatory moment in a dark apartment"
        fetchpriority="high"
      />
      <div class="hero-shade"></div>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">For couples who want more than a vanilla routine</p>
          <h1 id="hero-title">
            You’ve thought about it.<br />
            <em>Now talk about it.</em><br />
            Play with it. Enjoy it together.
          </h1>
          <p class="hero-lede">
            Practical, erotic, kink-informed education to help you name what you want, discover what excites you both, and explore BDSM and power dynamics with confidence.
          </p>
          <div class="hero-actions">
            <a class="button" href="/free-checklist/">Discover what you both want <ArrowRight size={15} /></a>
            <a class="text-link" href="#playbooks">Explore the playbooks <ArrowRight size={14} /></a>
          </div>
          <p class="hero-trust"><ShieldCheck size={15} /> Consent-first. Beginner-friendly. Created for real couples—not perfect performances.</p>
        </div>
      </div>
    </section>

    <section class="manifesto section-pad">
      <div class="narrow center">
        <p class="eyebrow">What Tension believes</p>
        <h2>Wanting it is rarely the hard part.<br /><em>Finding the words can be.</em></h2>
        <p class="lead">
          Kink isn’t only what happens in a scene. It can become a language for honesty, trust, anticipation, leadership, surrender, and erotic connection.
        </p>
        <blockquote>
          “The conversation before the scene isn’t paperwork.<br />It’s where the tension begins.”
          <cite>— Mr. D</cite>
        </blockquote>
      </div>
    </section>

    <section class="principles section-pad">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">More than better communication</p>
            <h2>Explore what brings<br /><em>you closer.</em></h2>
          </div>
          <p>Words matter. So do structure, attention, and what happens after the scene ends.</p>
        </div>
        <div class="principle-grid">
          {principles.map((item) => (
            <article>
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="method" class="method section-pad">
      <div class="shell">
        <div class="section-heading center">
          <p class="eyebrow">The Tension method</p>
          <h2>Better play starts<br /><em>before the scene.</em></h2>
        </div>
        <ol class="method-list">
          {method.map(([title, copy], index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div><h3>{title}</h3><p>{copy}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="mrd" class="mrd">
      <div class="mrd-image">
        <img src="/images/lp/tension-mrd-editorial-v1.jpg" alt="An open notebook, fountain pen, ribbon, and key in a private study" loading="lazy" />
      </div>
      <div class="mrd-copy">
        <p class="eyebrow">Meet your guide</p>
        <h2>Meet Mr. D.<br /><em>He’ll say the part most relationship advice avoids.</em></h2>
        <p>Mr. D is the editorial voice behind Tension: direct, kink-informed, occasionally provocative, and always interested in what helps real couples communicate and play better.</p>
        <p>He turns complex questions about desire, dominance, submission, boundaries, and erotic connection into practical conversations and experiences you can use together. No judgment. No clinical fog. No pretending that “just communicate” is a complete answer.</p>
        <blockquote>“You don’t need to become different people. You need better language for the parts of you that are already there.”</blockquote>
        <a class="text-link" href="/about/">About Mr. D and Tension <ArrowRight size={14} /></a>
        <small>Mr. D is an editorial coaching persona created by Tension. His guidance combines established consent practices, relationship frameworks, community knowledge, research, and extensive editorial development. Tension is education—not therapy or individualized professional care.</small>
      </div>
    </section>

    <section class="checklist section-pad">
      <div class="shell checklist-grid">
        <div class="checklist-image">
          <img src="/images/lp/tension-checklist-v3.png" alt="A Tension notebook and pen beside a glass" loading="lazy" />
        </div>
        <div class="checklist-copy">
          <p class="eyebrow">Start with a conversation</p>
          <h2>The Couples Kink<br /><em>Discovery Checklist</em></h2>
          <p class="lead">Ninety activities. Five responses. One conversation that is much easier than “So… what are you into?”</p>
          <ul>
            <li><Check size={16} /> Seven categories, from sensory play to power exchange</li>
            <li><Check size={16} /> More useful than a yes-or-no list</li>
            <li><Check size={16} /> Designed to complete together, in real time</li>
            <li><Check size={16} /> Free and delivered discreetly</li>
          </ul>
          <a class="button" href="/free-checklist/">Discover what you both want <ArrowRight size={15} /></a>
        </div>
      </div>
    </section>

    <section id="playbooks" class="scene-series section-pad">
      <div class="shell">
        <div class="section-heading split-heading">
          <div>
            <p class="eyebrow">Tension Play · The Scene Collection</p>
            <h2>Don’t improvise the whole thing.<br /><em>Start with a frame.</em></h2>
          </div>
          <p>Three levels. Seven complete D/s scene blueprints in each. Choose the collection that matches the trust and vocabulary you already share.</p>
        </div>
        <div class="scene-visual">
          <img src="/images/lp/tension-guide-scenes.png" alt="Dark editorial arrangement representing the Tension scene playbooks" loading="lazy" />
          <div><span>21</span><p>scene blueprints<br />across three levels</p></div>
        </div>
        <div class="scene-grid">
          {scenes.map((scene) => (
            <a href={scene.href} class="scene-card">
              <div class="scene-card-top"><span>{scene.level}</span><strong>{scene.number}</strong></div>
              <h3>7 D/s Scenes:<br /><em>{scene.title}</em></h3>
              <p>{scene.copy}</p>
              <small>{scene.detail}</small>
              <b>Explore this collection <ArrowRight size={14} /></b>
            </a>
          ))}
        </div>
        <p class="scope-note">The current scene collections are written for a male Dominant/female submissive dynamic. Readiness guidance and consent practices are included throughout.</p>
      </div>
    </section>

    <section class="guides section-pad">
      <div class="shell">
        <div class="section-heading center">
          <p class="eyebrow">Talk better. Play better.</p>
          <h2>Practical tools for<br /><em>what happens between you.</em></h2>
        </div>
        <div class="guide-grid">
          {guides.map((guide) => (
            <a class="guide-card" href={guide.href}>
              <div class="guide-image"><img src={guide.image} alt="" loading="lazy" /></div>
              <div class="guide-copy">
                <span>{guide.eyebrow}</span>
                <h3>{guide.title}</h3>
                <p>{guide.copy}</p>
                <b>Explore the guide <ArrowRight size={14} /></b>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="trust section-pad">
      <div class="shell trust-grid">
        <div>
          <p class="eyebrow">Our standards</p>
          <h2>Exciting enough to use.<br /><em>Grounded enough to trust.</em></h2>
          <p>Safety is not a paragraph added after the interesting part. It is built into how Tension teaches conversation, preparation, play, and reconnection.</p>
        </div>
        <div class="trust-points">
          <article><ShieldCheck size={21} /><div><h3>Consent is active</h3><p>Specific, informed, mutual, and reversible at any point.</p></div></article>
          <article><MessageCircle size={21} /><div><h3>Curiosity is not pressure</h3><p>A “maybe” is information—not a promise about what happens next.</p></div></article>
          <article><Sparkles size={21} /><div><h3>Depth isn’t danger-seeking</h3><p>Advanced play asks for more preparation and sustained attention. Every activity still carries specific risks.</p></div></article>
          <article><BookOpen size={21} /><div><h3>Education has a scope</h3><p>We are not therapy, medical advice, legal advice, or crisis support.</p></div></article>
        </div>
      </div>
    </section>

    <section class="journal section-pad">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">The Tension Journal</p><h2>Read with<br /><em>Mr. D.</em></h2></div>
          <p>Plainspoken education about kink, BDSM, D/s relationships, and the parts nobody explains properly.</p>
        </div>
        <div class="journal-grid">
          {journal.map((post, index) => (
            <a href={post.href}>
              <span>0{index + 1}</span>
              <h3>{post.title}</h3>
              <p>{post.copy}</p>
              <b>Read the article <ArrowRight size={14} /></b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="closing section-pad">
      <div class="narrow center">
        <p class="eyebrow">Your next move</p>
        <h2>You don’t need the perfect scene.<br /><em>You need an honest next conversation.</em></h2>
        <p>Find out what you both want. The talking is where it starts.</p>
        <a class="button" href="/free-checklist/">Start the conversation <ArrowRight size={15} /></a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><a class="wordmark" href="/">TENSION</a><p>Intelligent, practical, erotic relationship education for couples.</p></div>
        <nav aria-label="Footer navigation">
          <a href="#method">Our method</a><a href="#mrd">Mr. D</a><a href="#playbooks">Playbooks</a><a href="/blog/">Journal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>
        </nav>
        <a class="mail" href="mailto:hello@tension.app" aria-label="Email Tension"><Mail size={18} /></a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; background: #050403; }
  :global(body) { background: #050403 !important; }
  .landing {
    --black: #050403;
    --black-soft: #0b0908;
    --panel: #100c0b;
    --ivory: #eee5da;
    --muted: #b7aa9e;
    --faint: #7d7168;
    --gold: #c99a45;
    --gold-dark: #5d421c;
    --red: #a80f1b;
    color: var(--ivory);
    background: var(--black);
    overflow: hidden;
    font-family: Inter, sans-serif;
  }
  .shell { width: min(calc(100% - 48px), 1180px); margin-inline: auto; }
  .narrow { width: min(calc(100% - 48px), 820px); margin-inline: auto; }
  .center { text-align: center; }
  .section-pad { padding: 110px 0; }
  a { color: inherit; text-decoration: none; }
  em { color: var(--gold); font-weight: 300; }
  .eyebrow { color: #d42a35; font: 600 11px/1.3 Inter, sans-serif; letter-spacing: .19em; text-transform: uppercase; }
  h2 { font: 300 clamp(38px, 5vw, 66px)/.98 Fraunces, serif; letter-spacing: -.035em; }
  .lead { color: var(--muted); font: 300 clamp(18px, 2vw, 23px)/1.55 Fraunces, serif; }
  .button { min-height: 50px; padding: 0 24px; display: inline-flex; align-items: center; justify-content: center; gap: 14px; color: #fff6ed; background: linear-gradient(180deg, #c21725, #94101a); border: 1px solid #d12634; font: 600 10px/1 Inter, sans-serif; letter-spacing: .14em; text-transform: uppercase; transition: transform .2s, filter .2s; }
  .button:hover { transform: translateY(-2px); filter: brightness(1.12); }
  .button--small { min-height: 38px; padding-inline: 18px; font-size: 8px; }
  .text-link { display: inline-flex; align-items: center; gap: 10px; color: var(--gold); font: 600 10px/1 Inter, sans-serif; letter-spacing: .12em; text-transform: uppercase; }
  .text-link:hover { color: #ebbd69; }
  .site-header { position: absolute; z-index: 20; inset: 0 0 auto; border-bottom: 1px solid rgba(255,255,255,.08); background: linear-gradient(180deg, rgba(2,2,2,.85), rgba(2,2,2,.18)); }
  .header-inner { height: 76px; display: flex; align-items: center; }
  .wordmark { color: var(--gold); font: 400 20px/1 Fraunces, serif; letter-spacing: .28em; }
  .site-header nav { display: flex; gap: 32px; margin-left: auto; margin-right: 34px; }
  .site-header nav a, .site-footer nav a { color: #d2c8be; font: 600 9px/1 Inter, sans-serif; letter-spacing: .14em; text-transform: uppercase; }
  .site-header nav a:hover, .site-footer nav a:hover { color: var(--gold); }
  .hero { position: relative; min-height: 880px; isolation: isolate; display: flex; align-items: center; }
  .hero > img { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; filter: saturate(.82) brightness(.82); }
  .hero-shade { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, rgba(2,2,2,.97) 0%, rgba(2,2,2,.88) 26%, rgba(2,2,2,.28) 62%, rgba(2,2,2,.12) 100%), linear-gradient(180deg, rgba(0,0,0,.3), transparent 50%, #050403 100%); }
  .hero-inner { padding-top: 76px; }
  .hero-copy { width: min(660px, 58%); }
  .hero h1 { margin-top: 24px; font: 300 clamp(49px, 6.3vw, 86px)/.92 Fraunces, serif; letter-spacing: -.045em; text-shadow: 0 4px 30px #000; }
  .hero-lede { max-width: 620px; margin-top: 30px; color: #d3c7bc; font: 300 20px/1.55 Fraunces, serif; }
  .hero-actions { display: flex; align-items: center; gap: 28px; margin-top: 38px; }
  .hero-trust { margin-top: 25px; color: #988b81; display: flex; align-items: center; gap: 9px; font-size: 11px; }
  .manifesto { border-bottom: 1px solid #251b12; }
  .manifesto h2 { margin-top: 22px; }
  .manifesto .lead { max-width: 730px; margin: 32px auto 0; }
  .manifesto blockquote { margin-top: 56px; color: #e8dbce; font: italic 300 clamp(23px, 3vw, 34px)/1.35 Fraunces, serif; }
  .manifesto cite { display: block; margin-top: 17px; color: var(--gold); font: 600 9px/1 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
  .principles { background: var(--black-soft); }
  .section-heading { margin-bottom: 60px; }
  .section-heading h2 { margin-top: 18px; }
  .split-heading { display: flex; align-items: end; justify-content: space-between; gap: 60px; }
  .split-heading > p { width: min(420px, 40%); color: var(--muted); line-height: 1.65; }
  .principle-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #3b2a18; border-bottom: 1px solid #3b2a18; }
  .principle-grid article { min-height: 300px; padding: 34px 28px; border-right: 1px solid #3b2a18; }
  .principle-grid article:last-child { border-right: 0; }
  .principle-grid span { color: var(--gold); font: 300 28px/1 Fraunces, serif; }
  .principle-grid h3 { margin-top: 66px; font: 300 25px/1.05 Fraunces, serif; }
  .principle-grid p { margin-top: 18px; color: var(--muted); font-size: 13px; line-height: 1.65; }
  .method { background: radial-gradient(circle at 50% 30%, #17100d, #050403 55%); }
  .method-list { width: min(100%, 900px); margin: 0 auto; border-top: 1px solid #392716; }
  .method-list li { display: grid; grid-template-columns: 90px 1fr; gap: 20px; align-items: center; padding: 27px 20px; border-bottom: 1px solid #392716; }
  .method-list > li > span { color: var(--gold); font: 300 28px/1 Fraunces, serif; }
  .method-list h3 { font: 300 25px/1.1 Fraunces, serif; }
  .method-list p { margin-top: 8px; color: var(--muted); font-size: 13px; line-height: 1.55; }
  .mrd { display: grid; grid-template-columns: 1fr 1fr; min-height: 760px; background: #0d0a08; }
  .mrd-image { min-height: 660px; overflow: hidden; }
  .mrd-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.78) brightness(.77); }
  .mrd-copy { padding: 95px clamp(45px, 7vw, 110px); align-self: center; }
  .mrd-copy h2 { margin-top: 19px; font-size: clamp(39px, 4.5vw, 62px); }
  .mrd-copy > p:not(.eyebrow) { margin-top: 24px; color: var(--muted); font: 300 17px/1.7 Fraunces, serif; }
  .mrd-copy blockquote { margin: 31px 0; padding-left: 22px; border-left: 1px solid var(--gold); color: #e7d9cd; font: italic 300 20px/1.45 Fraunces, serif; }
  .mrd-copy small { display: block; max-width: 680px; margin-top: 32px; color: #a99b90; font-size: 12px; line-height: 1.65; }
  .checklist { background: #070605; }
  .checklist-grid { display: grid; grid-template-columns: 1.02fr .98fr; align-items: center; gap: clamp(45px, 8vw, 110px); }
  .checklist-image { height: 610px; overflow: hidden; }
  .checklist-image img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.75) brightness(.78); }
  .checklist-copy h2 { margin-top: 18px; }
  .checklist-copy .lead { margin-top: 25px; font-size: 20px; }
  .checklist-copy ul { display: grid; gap: 14px; margin: 30px 0 36px; }
  .checklist-copy li { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 13px; }
  .checklist-copy li :global(svg) { color: var(--gold); flex: none; }
  .scene-series { background: #0d0908; }
  .scene-visual { position: relative; height: 390px; margin-bottom: 28px; overflow: hidden; border: 1px solid #332113; }
  .scene-visual img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.62) saturate(.72); transform: scale(1.04); }
  .scene-visual::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(5,4,3,.15), rgba(5,4,3,.82)); }
  .scene-visual div { position: absolute; z-index: 2; right: 7%; top: 50%; transform: translateY(-50%); display: flex; align-items: center; gap: 24px; }
  .scene-visual span { color: var(--gold); font: 300 110px/.8 Fraunces, serif; }
  .scene-visual p { color: #d7cabf; font: 300 18px/1.35 Fraunces, serif; }
  .scene-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .scene-card { min-height: 430px; padding: 31px; display: flex; flex-direction: column; background: #110d0b; border: 1px solid #332113; transition: transform .2s, border-color .2s; }
  .scene-card:hover { transform: translateY(-4px); border-color: var(--gold-dark); }
  .scene-card-top { display: flex; align-items: start; justify-content: space-between; }
  .scene-card-top span { color: #d52d39; font: 600 9px/1 Inter, sans-serif; letter-spacing: .18em; text-transform: uppercase; }
  .scene-card-top strong { color: #44301e; font: 300 55px/1 Fraunces, serif; }
  .scene-card h3 { margin-top: 40px; font: 300 30px/1.03 Fraunces, serif; }
  .scene-card p { margin-top: 20px; color: var(--muted); font-size: 13px; line-height: 1.65; }
