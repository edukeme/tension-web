---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight, Check, Mail } from '@lucide/astro';

export const prerender = true;

const steps = [
  ['Find the words', 'Name what matters.\nSpeak clearly.\nListen deeply.'],
  ['Build the frame', 'Create rituals and agreements\nthat hold in real life.'],
  ['Explore with care', 'Move at a pace that feels safe,\ncurious, and connected.'],
];

const guides = [
  {
    title: 'The Kink Conversation Workbook',
    line: 'Speak clearly. Listen deeply.',
    copy: 'Practical questions and frameworks for desire, boundaries, and repair.',
    href: '/negotiation-workbook/',
    image: '/images/lp/tension-guide-language-v3.png',
  },
  {
    title: 'First Explorations',
    line: 'A frame for your first scenes.',
    copy: 'Seven guided D/s scenes designed for couples beginning together.',
    href: '/7-scenes-first-explorations/',
    image: '/images/lp/tension-guide-rituals-v3.png',
  },
  {
    title: 'The Tension Scene Collection',
    line: 'More trust. Better play.',
    copy: 'Beginner, intermediate, and advanced guides for deeper erotic connection.',
    href: '/7-scenes-deep-game/',
    image: '/images/lp/tension-guide-intimacy-v3.png',
  },
];

const journal = [
  {
    title: 'Connection, not perfection',
    line: 'Why presence matters more than performance.',
    href: '/blog/bdsm-sex-integration/',
    image: '/images/lp/tension-journal-connection-v3.png',
  },
  {
    title: 'Three questions that change everything',
    line: 'A weekly check-in that brings you closer.',
    href: '/blog/topic/relationships/',
    image: '/images/lp/tension-journal-questions-v3.png',
  },
  {
    title: 'Desire grows in the details',
    line: 'Small moments. Consistent care. Lasting impact.',
    href: '/blog/bdsm-starter-kit/',
    image: '/images/lp/tension-journal-desire-v3.png',
  },
];
---

<BaseLayout
  title="Kink-Informed Relationship Education for Couples"
  description="Articles, practical questions, role plays, and scene guides for couples exploring kink, BDSM, and power dynamics."
  canonical="/"
  ogImage="/images/lp/tension-hero-v5.png"
  hideChrome={true}
>
  <main class="landing">
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Tension home">TENSION</a>
        <nav aria-label="Primary navigation">
          <a href="/about/">About</a>
          <a href="#approach">Approach</a>
          <a href="#checklist">Tools</a>
          <a href="#guides">Guides</a>
          <a href="#journal">Journal</a>
        </nav>
        <a class="button button--header" href="/free-checklist/">Get the checklist</a>
      </div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <img src="/images/lp/tension-hero-v5.png" alt="An adult couple sharing a close, intimate moment on a sofa" fetchpriority="high" />
      <div class="hero-overlay"></div>
      <div class="shell hero-inner">
        <h1 id="hero-title">For couples exploring<br /><em>kink, BDSM, and power dynamics.</em></h1>
        <p class="hero-line">More <em>trust.</em> More <em>play.</em> More <em>erotic connection.</em></p>
        <a class="button" href="/free-checklist/">Get the free checklist <ArrowRight size={14} /></a>
      </div>
    </section>

    <section id="approach" class="approach section">
      <div class="shell">
        <div class="intro">
          <p class="eyebrow">Our approach</p>
          <h2>Stronger connection<br /><em>is built, not left to chance.</em></h2>
          <span class="ornament" aria-hidden="true"></span>
          <p class="intro-copy">Tension gives couples the language, structure, and tools to explore kink with more trust, curiosity, and erotic connection. Mr. D brings a direct, experienced editorial voice to the questions most advice avoids.</p>
        </div>

        <p class="eyebrow how-label">How it works</p>
        <div class="steps">
          {steps.map(([title, copy], index) => (
            <article class="step">
              <div class="step-number"><span>0{index + 1}</span><i></i></div>
              <h3>{title}</h3>
              <p>{copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="checklist" class="checklist">
      <div class="checklist-image">
        <img src="/images/lp/tension-checklist-v3.png" alt="A Tension notebook and pen beside a glass" loading="lazy" />
      </div>
      <div class="checklist-content">
        <p class="eyebrow">Free resource</p>
        <h2>The Couples Checklist</h2>
        <p class="gold-line">90 activities to spark better conversations and deeper connection.</p>
        <ul>
          <li><Check size={15} /> 10 conversation starters</li>
          <li><Check size={15} /> Consent and comfort guide</li>
          <li><Check size={15} /> Rituals that strengthen connection</li>
          <li><Check size={15} /> A simple weekly check-in</li>
        </ul>
        <div class="checklist-action">
          <strong>90 <span>activities</span></strong>
          <div>
            <a class="button" href="/free-checklist/">Get the checklist <ArrowRight size={14} /></a>
            <small>No spam. Unsubscribe anytime.</small>
          </div>
        </div>
      </div>
    </section>

    <section id="guides" class="catalog section">
      <div class="shell">
        <p class="eyebrow section-label">Guides</p>
        <div class="card-grid">
          {guides.map((guide) => (
            <article class="card">
              <a class="card-image" href={guide.href}><img src={guide.image} alt="" loading="lazy" /></a>
              <h3><a href={guide.href}>{guide.title}</a></h3>
              <p class="card-line">{guide.line}</p>
              <p class="card-copy">{guide.copy}</p>
              <a class="more" href={guide.href}>Learn more <ArrowRight size={13} /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="journal" class="catalog journal section">
      <div class="shell">
        <p class="eyebrow section-label">Journal</p>
        <div class="card-grid">
          {journal.map((article) => (
            <article class="card journal-card">
              <a class="card-image" href={article.href}><img src={article.image} alt="" loading="lazy" /></a>
              <h3><a href={article.href}>{article.title}</a></h3>
              <p class="card-line">{article.line}</p>
              <a class="more" href={article.href}>Read more <ArrowRight size={13} /></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="closing section">
      <div class="shell">
        <h2>You only need<br /><em>a next conversation.</em></h2>
        <a class="button" href="/free-checklist/">Get the free checklist <ArrowRight size={14} /></a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="wordmark" href="/">TENSION</a>
        <nav aria-label="Footer navigation">
          <a href="/about/">About</a><a href="#approach">Approach</a><a href="#checklist">Tools</a><a href="#guides">Guides</a><a href="#journal">Journal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a>
        </nav>
        <a class="mail" href="mailto:hello@tension.app" aria-label="Email Tension"><Mail size={17} /></a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(html) { scroll-behavior:smooth; background:#030303; }
  :global(body) { background:#030303 !important; }
  .landing { --black:#030303; --ivory:#eee8df; --muted:#b9afa5; --gold:#c89024; --red:#b40f1c; color:var(--ivory); background:var(--black); overflow:hidden; font-family:Inter,sans-serif; }
  .shell { width:min(calc(100% - 56px),1180px); margin-inline:auto; }
  a { color:inherit; text-decoration:none; }
  em { color:var(--gold); font-weight:300; }
  .eyebrow { color:#d4212d; font:700 9px/1 Inter,sans-serif; letter-spacing:.22em; text-transform:uppercase; }
  .wordmark { color:var(--gold); font:400 18px/1 Fraunces,serif; letter-spacing:.27em; }
  .button { min-height:48px; padding:0 25px; display:inline-flex; align-items:center; justify-content:center; gap:13px; color:#fff; background:#aa1019; border:1px solid #c51b26; font:700 9px/1 Inter,sans-serif; letter-spacing:.15em; text-transform:uppercase; transition:background .2s,transform .2s; }
  .button:hover { background:#c01521; transform:translateY(-2px); }
  .site-header { position:absolute; z-index:10; inset:0 0 auto; }
  .header-inner { height:72px; display:flex; align-items:center; }
  .site-header nav { display:flex; gap:34px; margin-left:auto; margin-right:35px; }
  .site-header nav a,.site-footer nav a { color:#d4cec8; font:700 8px/1 Inter,sans-serif; letter-spacing:.14em; text-transform:uppercase; }
  .site-header nav a:hover,.site-footer nav a:hover { color:var(--gold); }
  .button--header { min-height:40px; padding-inline:22px; font-size:8px; }
  .hero { position:relative; height:min(760px,100vh); min-height:640px; display:flex; align-items:flex-end; isolation:isolate; }
  .hero>img { position:absolute; z-index:-2; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; }
  .hero-overlay { position:absolute; z-index:-1; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.08) 0%,rgba(0,0,0,.02) 35%,rgba(0,0,0,.54) 70%,#030303 100%),linear-gradient(90deg,rgba(0,0,0,.28),transparent 20%,transparent 80%,rgba(0,0,0,.28)); }
  .hero-inner { padding-bottom:38px; text-align:center; }
  .hero h1 { font:300 clamp(48px,5.4vw,78px)/.98 Fraunces,serif; letter-spacing:-.035em; text-shadow:0 3px 22px #000; }
  .hero h1 em { display:inline-block; margin-top:7px; font-style:italic; }
  .hero-line { margin:24px 0 30px; color:#d8d0c7; font:italic 300 19px/1.4 Fraunces,serif; }
  .section { padding:70px 0; }
  .approach { padding-top:36px; }
  .intro { max-width:760px; margin-inline:auto; text-align:center; }
  .intro h2,.closing h2 { margin-top:15px; font:300 clamp(38px,4.5vw,57px)/1.03 Fraunces,serif; letter-spacing:-.025em; }
  .ornament { display:block; width:52px; height:1px; margin:24px auto; background:var(--gold); position:relative; }
  .ornament::before,.ornament::after { content:""; position:absolute; top:-2px; width:5px; height:5px; border:1px solid var(--gold); transform:rotate(45deg); }
  .ornament::before { left:-6px; }.ornament::after { right:-6px; }
  .intro-copy { max-width:670px; margin-inline:auto; color:var(--muted); font:300 15px/1.65 Fraunces,serif; }
  .how-label { margin:47px 0 22px; text-align:center; }
  .steps { display:grid; grid-template-columns:repeat(3,1fr); }
  .step { text-align:center; }
  .step-number { height:36px; display:flex; align-items:center; }
  .step-number span { width:72px; color:var(--gold); font:300 34px/1 Fraunces,serif; }
  .step-number i { height:1px; flex:1; background:var(--gold); position:relative; opacity:.82; }
  .step-number i::before,.step-number i::after { content:""; position:absolute; top:-2px; width:5px; height:5px; border-radius:50%; background:var(--gold); }
  .step-number i::before { left:0; }.step-number i::after { right:0; }
  .step:last-child .step-number i { visibility:hidden; }
  .step h3 { margin-top:13px; font:300 22px/1.15 Fraunces,serif; }
  .step p { margin-top:9px; color:var(--muted); white-space:pre-line; font:300 13px/1.45 Fraunces,serif; }
  .checklist { width:min(100%,1440px); margin-inline:auto; display:grid; grid-template-columns:1fr 1fr; background:#050505; }
  .checklist-image { min-height:560px; }
  .checklist-image img { width:100%; height:100%; object-fit:cover; }
  .checklist-content { padding:55px clamp(45px,6vw,94px); display:flex; flex-direction:column; justify-content:center; }
  .checklist-content h2 { margin-top:13px; font:300 clamp(35px,3.5vw,50px)/1 Fraunces,serif; }
  .gold-line { margin-top:11px; color:var(--gold); font:italic 300 21px/1.25 Fraunces,serif; }
  .checklist-content ul { display:grid; gap:12px; margin:27px 0 34px; }
  .checklist-content li { display:flex; align-items:center; gap:11px; color:#c7beb5; font:300 13px/1.3 Fraunces,serif; }
  .checklist-content li :global(svg) { color:var(--gold); border:1px solid var(--gold); border-radius:50%; padding:2px; }
  .checklist-action { display:flex; align-items:flex-end; gap:38px; }
  .checklist-action strong { color:var(--gold); font:300 82px/.72 Fraunces,serif; }
  .checklist-action strong span { display:block; margin-top:18px; font:600 10px/1 Inter,sans-serif; letter-spacing:.18em; text-transform:uppercase; }
  .checklist-action small { display:block; margin-top:11px; color:#8e857d; font:300 10px/1 Fraunces,serif; text-align:center; }
  .catalog { padding-top:44px; }
  .section-label { margin-bottom:20px; text-align:center; }
  .card-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .card-image { display:block; height:285px; overflow:hidden; background:#0b0908; }
  .card-image img { width:100%; height:100%; object-fit:cover; filter:brightness(.78) saturate(.83); transition:transform .45s,filter .45s; }
  .card:hover .card-image img { transform:scale(1.025); filter:brightness(.9) saturate(.9); }
  .card h3 { margin:18px 22px 0; font:300 24px/1.08 Fraunces,serif; }
  .card-line { margin:7px 22px 0; color:var(--gold); font:italic 300 17px/1.25 Fraunces,serif; }
  .card-copy { min-height:60px; margin:10px 22px 0; color:var(--muted); font:300 13px/1.5 Fraunces,serif; }
  .more { margin:22px; display:inline-flex; align-items:center; gap:11px; color:var(--gold); font:700 9px/1 Inter,sans-serif; letter-spacing:.13em; text-transform:uppercase; }
  .journal { padding-top:16px; }
  .journal .card-image { height:270px; }
  .journal-card h3 { max-width:290px; }
  .journal-card .more { margin-top:25px; }
  .closing { padding:68px 0 74px; text-align:center; }
  .closing .button { margin-top:28px; }
  .site-footer { padding:30px 0; }
  .footer-inner { min-height:64px; border-top:1px solid rgba(200,144,36,.28); display:grid; grid-template-columns:1fr auto 1fr; gap:35px; align-items:end; padding-top:28px; }
  .site-footer .wordmark { justify-self:start; font-size:13px; }
  .site-footer nav { display:flex; flex-wrap:wrap; justify-content:center; gap:25px; }
  .mail { justify-self:end; color:var(--gold); }
  a:focus-visible { outline:1px solid var(--gold); outline-offset:4px; }

  @media (max-width:900px) {
    .site-header nav { display:none; }
    .site-header .button { margin-left:auto; }
    .hero { height:720px; min-height:0; }
    .hero>img { object-position:center; }
    .checklist { grid-template-columns:1fr; }
    .checklist-image { min-height:500px; }
    .checklist-content { padding:60px max(28px,8vw); }
    .card-grid { gap:12px; }
    .card-image { height:230px; }
    .journal .card-image { height:220px; }
    .footer-inner { grid-template-columns:1fr auto; }
    .site-footer nav { display:none; }
  }

  @media (max-width:640px) {
    .shell { width:min(calc(100% - 32px),1180px); }
    .header-inner { height:65px; }
    .wordmark { font-size:15px; }
    .button--header { min-height:36px; padding-inline:13px; font-size:7px; }
    .hero { height:680px; }
    .hero>img { object-position:53% center; }
    .hero-inner { padding-bottom:48px; }
    .hero h1 { font-size:43px; }
    .hero-line { font-size:16px; }
    .approach { padding-top:22px; }
    .section { padding-block:60px; }
    .steps { grid-template-columns:1fr; gap:34px; }
    .step-number { max-width:310px; margin-inline:auto; }
    .step:last-child .step-number i { visibility:visible; }
    .checklist-image { min-height:390px; }
    .checklist-content { padding:50px 24px; }
    .checklist-action { align-items:flex-start; flex-direction:column; gap:27px; }
    .checklist-action strong { font-size:72px; }
    .card-grid { grid-template-columns:1fr; gap:44px; }
    .card-image,.journal .card-image { height:290px; }
    .card h3,.card-line,.card-copy,.more { margin-left:6px; margin-right:6px; }
    .card-copy { min-height:0; }
    .journal { padding-top:5px; }
    .closing { padding-top:45px; }
  }
</style>
