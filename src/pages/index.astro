---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCaptureForm from '@/components/EmailCaptureForm.astro';
import { ArrowRight, Camera, Check, Heart, Mail, MessageSquare, PanelsTopLeft } from '@lucide/astro';

export const prerender = true;

const guides = [
  {
    href: '/negotiation-workbook/',
    title: 'The Language Field Guide',
    line: 'Speak clearly. Listen deeply.',
    description: 'Practical frameworks for better conversations and repair.',
    image: '/images/lp/tension-guide-negotiation.png',
  },
  {
    href: '/21-scenes/',
    title: 'The Rituals Playbook',
    line: 'Small rituals. Big results.',
    description: 'Design simple rituals that build safety and closeness.',
    image: '/images/lp/tension-guide-scenes.png',
  },
  {
    href: '/brat-playbook/',
    title: 'The Intimacy Workbook',
    line: 'Explore with care.',
    description: 'Guided exercises for desire, boundaries, and pleasure.',
    image: '/images/lp/tension-guide-brat.png',
  },
];
---

<BaseLayout title="Intentional Intimacy for Couples and Singles" description="Language, structure, and consent-first tools for a more intentional relationship." canonical="/" hideChrome={true}>
  <main class="landing">
    <header class="site-header">
      <div class="page-width header-inner">
        <a class="wordmark" href="/" aria-label="Tension home">TENSION</a>
        <nav aria-label="Primary navigation">
          <a href="/about/">About</a>
          <a href="#approach">Approach</a>
          <a href="#guides">Tools</a>
          <a href="#guides">Guides</a>
          <a href="/blog/">Journal</a>
        </nav>
        <a class="button button--small" href="/free-checklist">Get the checklist</a>
      </div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <img src="/images/lp/tension-hero-couple.png" alt="A couple sharing a quiet, affectionate moment" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="page-width hero-content">
        <h1 id="hero-title">The relationship<br /><em>behind the scene.</em></h1>
        <p class="hero-promise">More <em>intention.</em> More <em>language.</em> More <em>trust.</em></p>
        <div class="hero-actions">
          <a class="button" href="/free-checklist">Get the free checklist <ArrowRight size={13} strokeWidth={1.35} /></a>
          <a class="text-link" href="#approach">See how it works</a>
        </div>
        <p class="microcopy">Private by default <i></i> Consent-first <i></i> Written for adults</p>
      </div>
    </section>

    <section class="principles" aria-label="The Tension approach">
      <div class="page-width principles-grid">
        <article>
          <MessageSquare class="principle-icon" size={43} strokeWidth={1.05} />
          <h2>Language</h2>
          <em>Find the words.</em>
          <p>Name what matters. Speak<br />clearly. Listen deeply.</p>
        </article>
        <article>
          <PanelsTopLeft class="principle-icon" size={43} strokeWidth={1.05} />
          <h2>Structure</h2>
          <em>Build the frame.</em>
          <p>Create rituals and agreements<br />that hold in real life.</p>
        </article>
        <article>
          <Heart class="principle-icon" size={43} strokeWidth={1.05} />
          <h2>Care</h2>
          <em>Explore with care.</em>
          <p>Move at a pace that feels safe,<br />curious, and connected.</p>
        </article>
      </div>
    </section>

    <section id="approach" class="approach section-space">
      <div class="page-width narrow center">
        <p class="kicker">Our approach</p>
        <h2>A clearer conversation<br /><em>starts here.</em></h2>
        <div class="ornament" aria-hidden="true"><span></span><i></i><span></span></div>
        <p class="section-intro">Tools for the relationship you are building.</p>
      </div>
    </section>

    <section id="how-it-works" class="process">
      <div class="page-width">
        <p class="kicker center">How it works</p>
        <div class="process-grid">
          <article><strong>1</strong><div><h3>Learn</h3><p>Short, focused guides<br />that teach what works.</p></div></article>
          <ArrowRight class="process-arrow" size={48} strokeWidth={.65} />
          <article><strong>2</strong><div><h3>Practice</h3><p>Conversation prompts<br />and exercises you can use.</p></div></article>
          <ArrowRight class="process-arrow" size={48} strokeWidth={.65} />
          <article><strong>3</strong><div><h3>Apply</h3><p>Build habits that create<br />more trust and ease.</p></div></article>
        </div>
      </div>
    </section>

    <section class="checklist">
      <div class="page-width checklist-panel">
        <div class="checklist-copy">
          <p class="kicker">Free resource</p>
          <h2>The Couples Checklist</h2>
          <em>Start with one honest conversation.</em>
          <ul>
            <li><Check size={15} strokeWidth={1.4} /> 10 conversation starters</li>
            <li><Check size={15} strokeWidth={1.4} /> Consent and comfort guide</li>
            <li><Check size={15} strokeWidth={1.4} /> Rituals that strengthen connection</li>
            <li><Check size={15} strokeWidth={1.4} /> A simple weekly check-in</li>
          </ul>
        </div>
        <div class="ninety"><strong>90</strong><span>Seconds</span><em>That can change<br />your next talk.</em></div>
        <div class="checklist-form">
          <EmailCaptureForm buttonLabel="Get the checklist →" placeholder="Your email address" />
          <small>No spam. Unsubscribe anytime.</small>
        </div>
      </div>
    </section>

    <section id="guides" class="guides section-space">
      <div class="page-width">
        <p class="kicker center">Guides</p>
        <div class="guide-grid">
          {guides.map((guide) => (
            <a class="guide-card" href={guide.href}>
              <div class="guide-image"><img src={guide.image} alt="" loading="lazy" /></div>
              <div class="guide-copy">
                <h3>{guide.title}</h3>
                <em>{guide.line}</em>
                <p>{guide.description}</p>
                <span>Learn more <ArrowRight size={15} strokeWidth={1.2} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="editorial">
      <div class="page-width">
        <p class="kicker center">Our editorial direction</p>
        <div class="editorial-grid">
          <a href="/blog/" class="editorial-card">
            <img src="/images/lp/tension-direction-editorial.png" alt="A couple sharing an intimate moment" loading="lazy" />
            <span><strong>Editorial intimacy</strong><em>Real moments. Human stories.</em><i></i></span>
          </a>
          <a href="/blog/topic/tools-guides/" class="editorial-card">
            <img src="/images/lp/tension-direction-tactile.png" alt="A journal and pen arranged in warm light" loading="lazy" />
            <span><strong>Tactile structure</strong><em>Beautiful tools. Clear guidance.</em><i></i></span>
          </a>
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="page-width center">
        <h2>You only need<br /><em>a next conversation.</em></h2>
        <a class="button" href="/free-checklist">Get the free checklist <ArrowRight size={13} strokeWidth={1.35} /></a>
        <p class="microcopy">Private by default <i></i> Consent-first <i></i> Written for adults</p>
      </div>
    </section>

    <footer class="site-footer">
      <div class="page-width footer-inner">
        <a class="wordmark" href="/">TENSION</a>
        <nav aria-label="Footer navigation"><a href="/about/">About</a><a href="#approach">Approach</a><a href="/blog/">Journal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
        <div class="social"><a href="#" aria-label="Instagram"><Camera size={16} strokeWidth={1.25} /></a><a href="mailto:hello@tension.com" aria-label="Email Tension"><Mail size={16} strokeWidth={1.25} /></a></div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(html) { scroll-behavior:smooth; background:#030303; }
  .landing {
    --black:#030303;
    --ivory:#e8e1d7;
    --ivory-soft:#c8c0b7;
    --gold:#b47b08;
    --gold-line:#805905;
    --red:#a20d18;
    --red-bright:#c31724;
    background:var(--black); color:var(--ivory); overflow:hidden;
    font-family:Inter,sans-serif;
  }
  .page-width { width:min(calc(100% - 58px), 688px); margin-inline:auto; }
  .center { text-align:center; }
  a { text-decoration:none; }
  .site-header { height:48px; background:#050505; position:absolute; inset:0 0 auto; z-index:20; }
  .header-inner { height:100%; display:flex; align-items:center; }
  .wordmark { color:var(--gold); font:400 16px/1 Fraunces,serif; letter-spacing:.25em; }
  .site-header nav { display:flex; gap:27px; margin-left:auto; margin-right:27px; }
  .site-header nav a,.site-footer nav a { color:#d7d0c8; font:600 7px/1 Inter,sans-serif; letter-spacing:.15em; text-transform:uppercase; transition:color .2s; }
  .site-header nav a:hover,.site-footer nav a:hover { color:var(--gold); }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:15px; min-height:33px; padding:0 18px; color:#f5eee7; background:linear-gradient(180deg,#b20e1a,#8f0912); border:1px solid #b10e1a; font:600 7px/1 Inter,sans-serif; letter-spacing:.16em; text-transform:uppercase; transition:filter .2s,transform .2s; }
  .button:hover { filter:brightness(1.18); transform:translateY(-1px); }
  .button--small { min-height:31px; padding:0 17px; }
  .hero { height:496px; position:relative; isolation:isolate; display:flex; align-items:flex-end; background:#090806; }
  .hero>img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 28%; z-index:-2; filter:brightness(.63) saturate(.64) sepia(.07); }
  .hero-shade { position:absolute; inset:0; z-index:-1; background:radial-gradient(ellipse 46% 62% at 50% 43%,transparent 0,rgba(0,0,0,.12) 55%,rgba(0,0,0,.73) 100%),linear-gradient(180deg,rgba(0,0,0,.04) 15%,rgba(0,0,0,.12) 50%,#030303 99%); }
  .hero-content { padding-bottom:36px; text-align:center; }
  .hero h1 { color:var(--ivory); font:300 48px/.91 Fraunces,serif; letter-spacing:-.035em; text-shadow:0 2px 18px #000; }
  .hero h1 em,.approach h2 em,.closing h2 em { color:var(--gold); font-weight:300; font-style:italic; }
  .hero-promise { margin-top:16px; color:#cfc6bd; font:italic 15px/1.3 Fraunces,serif; }
  .hero-promise em { color:var(--gold); }
  .hero-actions { margin-top:23px; display:flex; justify-content:center; align-items:center; gap:18px; }
  .text-link { color:var(--gold); font:600 7px/1 Inter,sans-serif; letter-spacing:.17em; text-transform:uppercase; padding:12px 4px; }
  .microcopy { margin-top:22px; color:#b7aea6; font:600 6.5px/1 Inter,sans-serif; letter-spacing:.17em; text-transform:uppercase; display:flex; justify-content:center; align-items:center; gap:9px; }
  .microcopy i { width:3px; height:3px; background:var(--gold); transform:rotate(45deg); }
  .principles { padding:29px 0 42px; }
  .principles-grid { display:grid; grid-template-columns:repeat(3,1fr); }
  .principles article { min-height:158px; padding:14px 14px 7px; text-align:center; border-right:1px solid var(--gold-line); }
  .principles article:last-child { border-right:0; }
  .principle-icon { color:var(--gold); margin:0 auto 15px; }
  .principles h2 { font:300 21px/1 Fraunces,serif; margin:0 0 5px; }
  .principles em { color:var(--gold); font:italic 13px/1.2 Fraunces,serif; }
  .principles p { color:#c5bdb5; font:400 10px/1.5 Fraunces,serif; margin-top:11px; }
  .section-space { padding:26px 0; }
  .narrow { max-width:590px; }
  .kicker { color:var(--red-bright); font:600 7px/1 Inter,sans-serif; letter-spacing:.25em; text-transform:uppercase; }
  .approach h2 { margin-top:16px; color:var(--ivory); font:300 35px/1.03 Fraunces,serif; letter-spacing:-.02em; }
  .ornament { display:flex; align-items:center; justify-content:center; gap:8px; width:215px; margin:19px auto 12px; }
  .ornament span { height:1px; flex:1; background:linear-gradient(90deg,transparent,var(--gold-line)); }
  .ornament span:last-child { background:linear-gradient(90deg,var(--gold-line),transparent); }
  .ornament i { width:6px; height:6px; border:1px solid var(--gold); transform:rotate(45deg); }
  .section-intro { color:#bdb4ac; font:400 14px/1.3 Fraunces,serif; }
  .process { padding:20px 0 45px; }
  .process-grid { margin-top:28px; display:grid; grid-template-columns:1fr 52px 1fr 52px 1fr; align-items:center; }
  .process-grid article { display:flex; align-items:center; gap:14px; }
  .process-grid strong { color:var(--gold); font:300 46px/.85 Fraunces,serif; }
  .process-grid h3 { font:300 16px/1 Fraunces,serif; }
  .process-grid p { margin-top:5px; color:#b9b0a8; font:400 9px/1.4 Fraunces,serif; }
  .process-arrow { color:var(--gold-line); }
  .checklist { padding:0 0 31px; }
  .checklist-panel { border:1px solid var(--gold-line); min-height:230px; display:grid; grid-template-columns:1.18fr .6fr 1fr; align-items:center; gap:24px; padding:25px 29px; }
  .checklist-copy h2 { font:300 24px/1 Fraunces,serif; margin:11px 0 6px; }
  .checklist-copy>em { color:var(--gold); font:italic 13px/1 Fraunces,serif; }
  .checklist-copy ul { display:grid; gap:7px; margin-top:18px; }
  .checklist-copy li { color:#c5bdb4; font:400 9px/1.2 Fraunces,serif; display:flex; align-items:center; gap:7px; }
  .checklist-copy li :global(svg) { color:var(--gold); border:1px solid var(--gold); border-radius:50%; padding:2px; flex:none; }
  .ninety { text-align:center; }
  .ninety strong { color:var(--gold); font:300 72px/.78 Fraunces,serif; letter-spacing:-.05em; }
  .ninety span { display:block; margin-top:6px; color:var(--gold); font:500 11px/1 Inter,sans-serif; letter-spacing:.28em; text-transform:uppercase; }
  .ninety em { display:block; margin-top:18px; color:#cfc6bd; font:italic 13px/1.3 Fraunces,serif; }
  .checklist-form small { display:block; margin-top:10px; color:#8d857d; font:400 8px/1 Fraunces,serif; text-align:center; }
  .checklist-form :global(#email-capture-form>div) { display:grid; grid-template-columns:1fr !important; gap:11px !important; }
  .checklist-form :global(#email-capture-form input) { width:100%; padding:12px 14px !important; border:1px solid var(--gold-line) !important; background:#050505 !important; color:var(--ivory) !important; font:500 7px/1 Inter,sans-serif !important; letter-spacing:.12em; text-transform:uppercase; }
  .checklist-form :global(#email-capture-form button) { width:100%; padding:12px !important; background:linear-gradient(180deg,#b20e1a,#8f0912) !important; border-color:#b10e1a !important; font:600 7px/1 Inter,sans-serif !important; letter-spacing:.14em; text-transform:uppercase; }
  .guides { padding-top:0; padding-bottom:31px; }
  .guide-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:17px; }
  .guide-card { display:flex; flex-direction:column; min-height:260px; border:1px solid var(--gold-line); background:#050504; transition:border-color .2s,transform .2s; }
  .guide-card:hover { border-color:var(--gold); transform:translateY(-2px); }
  .guide-image { height:105px; overflow:hidden; }
  .guide-image img { width:100%; height:100%; object-fit:cover; filter:brightness(.52) saturate(.45) sepia(.22); transition:transform .4s; }
  .guide-card:hover img { transform:scale(1.04); }
  .guide-copy { flex:1; display:flex; flex-direction:column; text-align:center; padding:12px 15px 15px; }
  .guide-copy h3 { font:300 17px/1.05 Fraunces,serif; }
  .guide-copy em { margin-top:6px; color:var(--gold); font:italic 11px/1.2 Fraunces,serif; }
  .guide-copy p { margin:13px auto; color:#b9b0a8; font:400 9px/1.45 Fraunces,serif; }
  .guide-copy span { margin-top:auto; color:var(--gold); display:flex; align-items:center; justify-content:center; gap:8px; font:600 7px/1 Inter,sans-serif; letter-spacing:.16em; text-transform:uppercase; }
  .editorial { padding-bottom:31px; }
  .editorial-grid { margin-top:16px; display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .editorial-card { position:relative; height:183px; overflow:hidden; border:1px solid var(--gold-line); }
  .editorial-card>img { width:100%; height:100%; object-fit:cover; filter:brightness(.47) saturate(.55) sepia(.18); transition:transform .4s; }
  .editorial-card:hover>img { transform:scale(1.025); }
  .editorial-card::after { content:''; position:absolute; inset:0; background:linear-gradient(90deg,rgba(0,0,0,.62),rgba(0,0,0,.08)); }
  .editorial-card>span { position:absolute; z-index:1; left:46px; bottom:35px; display:grid; }
  .editorial-card strong { font:300 19px/1 Fraunces,serif; }
  .editorial-card em { margin-top:7px; color:var(--gold); font:italic 12px/1 Fraunces,serif; }
  .editorial-card span i { width:25px; height:1px; background:var(--gold); margin-top:13px; }
  .closing { padding:0 0 16px; }
  .closing h2 { font:300 29px/1.02 Fraunces,serif; }
  .closing .button { margin-top:18px; }
  .closing .microcopy { margin-top:16px; }
  .site-footer { border-top:1px solid #3d2b05; min-height:57px; }
  .footer-inner { min-height:57px; display:flex; align-items:center; }
  .site-footer nav { display:flex; gap:27px; margin:auto; }
  .social { display:flex; gap:13px; }
  .social a { color:var(--gold); }
  a:focus-visible,input:focus-visible,button:focus-visible { outline:1px solid var(--gold); outline-offset:4px; }
  @media (max-width:680px) {
    .page-width { width:min(calc(100% - 30px),688px); }
    .site-header nav { display:none; }
    .site-header .button { margin-left:auto; }
    .hero { height:610px; }
    .hero>img { object-position:58% center; }
    .hero h1 { font-size:clamp(42px,13vw,60px); }
    .principles-grid,.guide-grid,.editorial-grid { grid-template-columns:1fr; }
    .principles article { border-right:0; border-bottom:1px solid var(--gold-line); padding:30px 10px; }
    .principles article:last-child { border-bottom:0; }
    .process-grid { grid-template-columns:1fr; gap:14px; width:min(100%,270px); margin-inline:auto; margin-top:28px; }
    .process-arrow { transform:rotate(90deg); margin-left:20px; }
    .checklist-panel { grid-template-columns:1fr; text-align:center; padding:30px 24px; }
    .checklist-copy ul { width:max-content; max-width:100%; margin-inline:auto; text-align:left; }
    .checklist-form { width:min(100%,320px); margin-inline:auto; }
    .guide-card { min-height:330px; }
    .guide-image { height:170px; }
    .editorial-card { height:230px; }
    .footer-inner { flex-wrap:wrap; justify-content:center; gap:18px; padding:18px 0; }
    .site-footer nav { order:3; width:100%; justify-content:center; gap:16px; }
  }
  @media (prefers-reduced-motion:reduce) { :global(*) { scroll-behavior:auto !important; transition-duration:.01ms !important; } }
</style>
