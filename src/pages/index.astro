---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCaptureForm from '@/components/EmailCaptureForm.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const products = await getCollection('products');
const productBySlug = (slug: string) => products.find(product => product.data.slug === slug);
const guides = [
  { slug: 'negotiation-workbook', title: 'The Negotiation Workbook', description: 'An 8-section fill-in workbook. From “we’ve been thinking about this” to a real D/s structure in one sitting.', price: '€9.90', image: '/images/lp/tension-guide-negotiation.png', label: 'Conversation' },
  { slug: '21-scenes', title: '21 Scenes That Will Drive You Crazy', description: '21 ready-to-run scene blueprints — beginner to advanced, with dialogue and aftercare.', price: '€9.90', image: '/images/lp/tension-guide-scenes.png', label: 'Practice' },
  { slug: 'brat-playbook', title: 'The Brat Submissive Playbook', description: 'The complete brat dynamics guide — for dominants who need to win, and submissives who need to be understood.', price: '€14.90', image: '/images/lp/tension-guide-brat.png', label: 'Dynamics' },
].map(guide => ({ ...guide, product: productBySlug(guide.slug) }));
---

<BaseLayout title="Intentional Intimacy Coaching for Couples" description="Tension gives couples and singles the language, structure, and consent-first tools to explore power dynamics with care." canonical="/" hideChrome={true}>
  <main class="lp-dark">
    <header class="lp-site-header">
      <div class="lp-header-inner">
        <a class="lp-mark" href="/">TENSION</a>
        <nav aria-label="Primary navigation"><a href="/about/">About</a><a href="#how-it-works">Approach</a><a href="#guides">Tools</a><a href="#guides">Guides</a><a href="/blog/">Journal</a></nav>
        <a class="lp-header-cta" href="/free-checklist">Get the checklist</a>
      </div>
    </header>
    <section class="tension-hero relative isolate min-h-[92svh] overflow-hidden bg-black">
      <img src="/images/lp/tension-hero-couple.png" alt="Two adults sharing a quiet, affectionate moment together" class="absolute inset-0 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,.28),rgba(0,0,0,.58)_55%,#000_100%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_10%,rgba(0,0,0,.42)_100%)]"></div>
      <div class="relative z-10 mx-auto flex min-h-[92svh] max-w-5xl items-center justify-center px-6 py-28 text-center"><div class="max-w-3xl">
        <p class="eyebrow mb-7 text-[#C9952E]">Tension · intentional intimacy</p>
        <h1 class="font-serif text-[clamp(3.1rem,8vw,7rem)] leading-[.92] tracking-[-.04em] text-[#F4F0E8]">The relationship<br /><em class="text-[#C9952E]">behind the scene.</em></h1>
        <p class="mx-auto mt-8 max-w-2xl text-base leading-7 text-[#F4F0E8]/80 md:text-lg">For couples and singles who want more intention, more language, and more trust in the way they explore.</p>
        <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"><a class="btn-primary" href="/free-checklist">Get the free couples checklist →</a><a class="btn-secondary" href="#how-it-works">See how Tension works</a></div>
        <p class="mt-8 text-[10px] font-semibold uppercase tracking-[.24em] text-[#F4F0E8]/65">Private by default · Consent-first · Written for adults</p>
      </div></div>
    </section>

    <section class="principles-section" aria-label="Tension principles"><div class="principles-grid">
      <article class="principle-card"><div class="gold-icon" aria-hidden="true">▢</div><h2>Language</h2><em>Say what you want without making it weird.</em></article>
      <article class="principle-card"><div class="gold-icon" aria-hidden="true">▦</div><h2>Structure</h2><em>Turn a fantasy into a conversation and a plan.</em></article>
      <article class="principle-card"><div class="gold-icon" aria-hidden="true">♡</div><h2>Care</h2><em>Keep consent, limits, and aftercare in the frame.</em></article>
    </div></section>

    <section class="positioning-section"><div><p class="eyebrow text-[#A61E2D]">A better starting point</p><h2 class="section-title mt-5">You do not need a new identity. You need a clearer conversation.</h2><div class="gold-rule mx-auto my-7 max-w-xs"></div><div class="positioning-copy"><p>Most people find Tension after the search results, the awkward half-conversation, or the moment one partner says: “I want to try something, but I do not know how.”</p><p>Start with the relationship you already have. Explore at the pace that fits your life. Keep what creates connection; leave what does not.</p></div></div></section>

    <section id="how-it-works" class="how-section"><div><p class="eyebrow text-center text-[#A61E2D]">How it works</p><div class="how-rail mt-10"><article><span>1</span><div><h3>Learn</h3><p>Short, focused guides that teach what works.</p></div></article><div class="rail-line" aria-hidden="true"></div><article><span>2</span><div><h3>Practice</h3><p>Conversation prompts and exercises you can use.</p></div></article><div class="rail-line" aria-hidden="true"></div><article><span>3</span><div><h3>Apply</h3><p>Build habits that create more trust and ease.</p></div></article></div></div></section>

    <section id="checklist" class="checklist-section"><div class="checklist-panel"><div><p class="eyebrow text-[#A61E2D]">Free resource</p><h2>The Couples Checklist</h2><em>Start with one honest conversation.</em><ul class="checklist-list"><li>10 conversation starters</li><li>Consent and comfort guide</li><li>Rituals that strengthen connection</li><li>A simple weekly check-in</li></ul></div><div class="checklist-stat"><strong>90</strong><span>SECONDS</span><em>That can change<br />your next talk.</em></div><div><h3>Get the checklist privately.</h3><p>No public profile. No sales call. Just the PDF and a useful place to begin.</p><div class="mt-5"><EmailCaptureForm buttonLabel="Get the checklist →" /></div><small>No spam. Unsubscribe anytime.</small></div></div></section>

    <section id="guides" class="guides-section"><div><p class="eyebrow text-center text-[#A61E2D]">Guides</p><div class="guide-grid">{guides.map(guide => (<a class="guide-card" href={`/${guide.slug}/`}><img src={guide.image} alt="" loading="lazy" /><div class="guide-overlay"></div><div class="relative z-10 flex h-full flex-col justify-end p-5"><h3>{guide.title}</h3><em>{guide.label}</em><p>{guide.description}</p><span>Learn more →</span></div></a>))}</div></div></section>

    <section class="direction-section"><div><p class="eyebrow text-center text-[#A61E2D]">Our editorial direction</p><div class="direction-grid"><a class="direction-card" href="/blog/"><img src="/images/lp/tension-direction-editorial.png" alt="Editorial intimacy: a couple in a quiet private moment" loading="lazy" /><span><strong>Editorial intimacy</strong><em>Real moments. Human stories.</em></span></a><a class="direction-card" href="/blog/topic/tools-guides/"><img src="/images/lp/tension-direction-tactile.png" alt="Tactile structure: abstract objects representing a private ritual" loading="lazy" /><span><strong>Tactile structure</strong><em>Beautiful tools. Clear guidance.</em></span></a></div></div></section>

    <section class="final-section"><div><h2>You only need<br /><em>a next conversation.</em></h2><a class="btn-primary mt-7" href="/free-checklist">Get the free checklist →</a><p class="lp-microcopy">Private by default <span>•</span> Consent-first <span>•</span> Written for adults</p></div></section>
    <footer class="lp-footer"><div><a class="lp-mark" href="/">TENSION</a><nav><a href="/about/">About</a><a href="#how-it-works">Approach</a><a href="/blog/">Journal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav><span>◎ &nbsp; ✉</span></div></footer>
  </main>
</BaseLayout>

<style>
  .lp-dark { background:#000; color:#F4F0E8; overflow:hidden; }
  .lp-site-header { position:absolute; z-index:20; inset:0 0 auto; background:rgba(0,0,0,.92); border-bottom:1px solid rgba(255,255,255,.04); }
  .lp-header-inner { width:min(100% - 52px, 690px); height:48px; margin:auto; display:flex; align-items:center; justify-content:space-between; }
  .lp-mark { color:#C9952E; font:600 15px/1 Fraunces,serif; letter-spacing:.24em; }
  .lp-site-header nav { display:flex; align-items:center; gap:23px; margin-left:auto; margin-right:22px; }
  .lp-site-header nav a { color:rgba(244,240,232,.82); font:600 8px/1 Inter,sans-serif; letter-spacing:.11em; text-transform:uppercase; }
  .lp-header-cta { background:#A61E2D; color:#fff; padding:10px 16px; font:700 8px/1 Inter,sans-serif; letter-spacing:.12em; text-transform:uppercase; }
  .tension-hero { min-height:510px !important; }
  .tension-hero > img { object-position:center 26%; filter:brightness(.68) saturate(.72); }
  .tension-hero > div:nth-of-type(1) { background:linear-gradient(180deg,rgba(0,0,0,.34),rgba(0,0,0,.18) 30%,#000 91%) !important; }
  .tension-hero > div:nth-of-type(2) { background:radial-gradient(circle at center 35%,transparent 8%,rgba(0,0,0,.58) 100%) !important; }
  .tension-hero > div:last-child { min-height:510px !important; padding:112px 22px 34px !important; align-items:center !important; }
  .tension-hero h1 { font-size:clamp(2.65rem,8.1vw,4.5rem) !important; }
  .tension-hero .eyebrow { font-size:8px; }
  .tension-hero p { max-width:470px; }
  .eyebrow { font:600 8px/1 Inter,sans-serif; letter-spacing:.24em; text-transform:uppercase; }
  .btn-primary { display:inline-flex; align-items:center; justify-content:center; background:#A61E2D; color:#F4F0E8; padding:.75rem 1.05rem; border:1px solid #A61E2D; font-size:8px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; transition:background .2s,border-color .2s,transform .2s; }
  .btn-primary:hover { background:#C9952E; border-color:#C9952E; color:#000; transform:translateY(-2px); }
  .btn-secondary { display:inline-flex; align-items:center; justify-content:center; border:0; color:#C9952E; padding:.75rem .7rem; font-size:8px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; transition:color .2s; }
  .btn-secondary:hover { background:transparent; color:#F4F0E8; }
  .gold-rule { height:1px; background:linear-gradient(90deg,transparent,#C9952E,transparent); }
  .principles-section { border-bottom:1px solid rgba(201,149,46,.5); background:#000; }
  .principles-grid,.positioning-section>div,.how-section>div,.checklist-panel,.guides-section>div,.direction-section>div,.final-section>div,.lp-footer>div { width:min(100% - 56px,690px); margin:auto; }
  .principles-grid { display:grid; grid-template-columns:repeat(3,1fr); }
  .principle-card { min-height:182px; padding:37px 18px 25px; text-align:center; border-right:1px solid rgba(201,149,46,.45); }
  .principle-card:last-child { border-right:0; }
  .gold-icon { color:#C9952E; font-size:28px; line-height:1; margin-bottom:13px; }
  .principle-card h2 { font:500 21px/1.1 Fraunces,serif; margin-bottom:5px; }
  .principle-card em { color:#C9952E; font:italic 13px/1.35 Fraunces,serif; }
  .positioning-section { background:#000; padding:52px 0 40px; text-align:center; }
  .section-title { color:#F4F0E8; font:500 clamp(2.15rem,5.4vw,3.35rem)/.98 Fraunces,serif; letter-spacing:-.035em; }
  .positioning-copy { width:min(100%,480px); margin:0 auto; color:rgba(244,240,232,.74); font:14px/1.68 Fraunces,serif; }
  .positioning-copy p + p { margin-top:13px; }
  .how-section { background:#000; padding:31px 0 44px; }
  .how-rail { display:grid; grid-template-columns:1fr 42px 1fr 42px 1fr; align-items:center; gap:12px; }
  .how-rail article { display:flex; gap:10px; align-items:start; }
  .how-rail article>span { color:#C9952E; font:400 48px/.8 Fraunces,serif; }
  .how-rail h3 { color:#F4F0E8; font:500 15px/1.1 Fraunces,serif; }
  .how-rail p { color:rgba(244,240,232,.7); font:11px/1.4 Fraunces,serif; margin-top:5px; }
  .rail-line { height:1px; background:#C9952E; opacity:.65; }
  .checklist-section { background:#000; padding:0 0 41px; }
  .checklist-panel { display:grid; grid-template-columns:1.08fr .54fr 1fr; align-items:center; gap:24px; border:1px solid rgba(201,149,46,.85); padding:28px 31px; }
  .checklist-panel h2 { color:#F4F0E8; font:500 25px/1.05 Fraunces,serif; margin:10px 0 2px; }
  .checklist-panel > div:first-child > em { color:#C9952E; font:italic 14px/1.35 Fraunces,serif; }
  .checklist-list { display:grid; gap:6px; margin-top:17px; color:rgba(244,240,232,.76); font:11px/1.4 Fraunces,serif; }
  .checklist-list li::before { content:'◉'; color:#C9952E; font-size:8px; margin-right:8px; }
  .checklist-stat { text-align:center; }
  .checklist-stat strong { display:block; color:#C9952E; font:400 76px/.8 Fraunces,serif; }
  .checklist-stat span { color:#C9952E; font:600 12px/1 Inter,sans-serif; letter-spacing:.26em; }
  .checklist-stat em { display:block; margin-top:14px; color:#F4F0E8; font:italic 14px/1.2 Fraunces,serif; }
  .checklist-panel h3 { color:#F4F0E8; font:500 18px/1.1 Fraunces,serif; }
  .checklist-panel > div:last-child > p { color:rgba(244,240,232,.64); font:11px/1.35 Inter,sans-serif; margin-top:8px; }
  .checklist-panel :global(#email-capture-form) { max-width:none; }
  .checklist-panel :global(#email-capture-form input) { min-width:0; background:transparent !important; border:1px solid rgba(201,149,46,.7) !important; color:#F4F0E8 !important; padding:10px !important; font-size:10px !important; }
  .checklist-panel :global(#email-capture-form button) { padding:10px 12px !important; font-size:8px !important; letter-spacing:.04em; }
  .checklist-panel small { display:block; color:rgba(244,240,232,.5); font:10px/1.3 Fraunces,serif; text-align:center; margin-top:8px; }
  .guides-section { background:#000; padding:0 0 45px; }
  .guide-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:19px; }
  .guide-card,.direction-card { position:relative; overflow:hidden; border:1px solid rgba(201,149,46,.8); background:#000; }
  .guide-card { min-height:270px; display:block; }
  .guide-card img,.direction-card img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:brightness(.44) saturate(.55) sepia(.16); transition:transform .4s; }
  .guide-card:hover img,.direction-card:hover img { transform:scale(1.04); }
  .guide-overlay { position:absolute; inset:0; background:linear-gradient(0deg,rgba(0,0,0,.97),rgba(0,0,0,.05) 80%); }
  .guide-card h3 { color:#F4F0E8; font:500 18px/1.1 Fraunces,serif; }
  .guide-card em { color:#C9952E; font:italic 12px/1.3 Fraunces,serif; margin-top:5px; }
  .guide-card p { color:rgba(244,240,232,.72); font:11px/1.4 Fraunces,serif; margin:15px 0; }
  .guide-card span { color:#C9952E; font:600 8px/1 Inter,sans-serif; letter-spacing:.13em; text-transform:uppercase; }
  .direction-section { background:#000; padding:0 0 45px; }
  .direction-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:17px; }
  .direction-card { min-height:180px; display:block; }
  .direction-card::after { content:''; position:absolute; inset:0; background:linear-gradient(0deg,rgba(0,0,0,.95),rgba(0,0,0,.08)); }
  .direction-card>span { position:absolute; z-index:1; inset:auto 22px 20px; display:grid; gap:3px; }
  .direction-card strong { color:#F4F0E8; font:500 20px/1.1 Fraunces,serif; }
  .direction-card em { color:#C9952E; font:italic 13px/1.35 Fraunces,serif; }
  .final-section { background:#000; padding:32px 0 24px; text-align:center; }
  .final-section h2 { color:#F4F0E8; font:500 31px/.98 Fraunces,serif; }
  .final-section em { color:#C9952E; }
  .lp-microcopy { color:rgba(244,240,232,.58); font:600 8px/1 Inter,sans-serif; letter-spacing:.15em; text-transform:uppercase; margin-top:18px; }
  .lp-microcopy span { color:#C9952E; padding:0 7px; }
  .lp-footer { background:#000; border-top:1px solid rgba(201,149,46,.45); padding:20px 0; }
  .lp-footer>div { display:flex; align-items:center; justify-content:space-between; }
  .lp-footer nav { display:flex; gap:18px; }
  .lp-footer nav a,.lp-footer>div>span { color:rgba(244,240,232,.7); font:600 8px/1 Inter,sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  a:focus-visible,input:focus-visible,button:focus-visible { outline:2px solid #C9952E; outline-offset:3px; }
  @media (max-width:610px) { .lp-header-inner{width:min(100% - 28px,690px)} .lp-site-header nav{display:none} .lp-header-cta{margin-left:auto} .tension-hero,.tension-hero>div:last-child{min-height:560px!important} .principles-grid,.guide-grid,.direction-grid{grid-template-columns:1fr} .principle-card{min-height:0;border-right:0;border-bottom:1px solid rgba(201,149,46,.45)} .principle-card:last-child{border-bottom:0} .how-rail{grid-template-columns:1fr;gap:17px} .rail-line{width:1px;height:23px;margin-left:18px} .checklist-panel{grid-template-columns:1fr;text-align:center;padding:25px 22px} .checklist-list{text-align:left;width:max-content;max-width:100%;margin-inline:auto} .checklist-panel :global(#email-capture-form>div){flex-direction:column;gap:8px} .lp-footer>div{flex-wrap:wrap;gap:17px;justify-content:center} }
  @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; transition-duration:.01ms!important; animation-duration:.01ms!important; } }
</style>
