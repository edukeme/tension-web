---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight, Check, Mail, ShieldCheck } from '@lucide/astro';

export const prerender = true;

const steps = [
  {
    title: 'Find the words',
    copy: 'Talk about desire, boundaries, and curiosity without making it a big performance.',
  },
  {
    title: 'Choose together',
    copy: 'Discover what genuinely interests both of you. A maybe is allowed to stay a maybe.',
  },
  {
    title: 'Try with a frame',
    copy: 'Use agreements, role plays, and scene guides so you can focus on each other.',
  },
];

const guides = [
  {
    label: 'Start here',
    title: 'The Couples Kink Discovery Checklist',
    copy: 'Ninety activities and five possible answers to make the first conversation easier.',
    href: '/free-checklist/',
    image: '/images/lp/tension-checklist-v3.png',
    cta: 'Get the free checklist',
  },
  {
    label: 'Talk',
    title: 'The Kink Conversation Workbook',
    copy: 'Turn “we’ve been thinking about this” into a real, shared structure.',
    href: '/negotiation-workbook/',
    image: '/images/lp/tension-guide-negotiation.png',
    cta: 'Explore the workbook',
  },
  {
    label: 'Play',
    title: 'The Tension Scene Collection',
    copy: 'Beginner, intermediate, and advanced D/s scene guides for couples ready to explore.',
    href: '#playbooks',
    image: '/images/lp/tension-guide-scenes.png',
    cta: 'Explore the scene guides',
  },
];

const playbooks = [
  ['Beginner', 'First Explorations', '/7-scenes-first-explorations/'],
  ['Intermediate', 'The Deep Game', '/7-scenes-deep-game/'],
  ['Advanced', 'The Edge', '/7-scenes-the-edge/'],
];
---

<BaseLayout
  title="Kink-Informed Relationship Education for Couples"
  description="Articles, practical questions, role plays, and scene guides for couples exploring kink, BDSM, and power dynamics."
  canonical="/"
  ogImage="/images/lp/tension-hero-v4.jpg"
  hideChrome={true}
>
  <div class="landing">
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Tension home">TENSION</a>
        <nav aria-label="Primary navigation">
          <a href="#how-it-works">How it works</a>
          <a href="#mrd">Mr. D</a>
          <a href="#playbooks">Guides</a>
          <a href="/blog/">Journal</a>
        </nav>
        <a class="button button--small" href="/free-checklist/">Get the free checklist</a>
      </div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <img src="/images/lp/tension-hero-v4.jpg" alt="An adult couple sharing a quiet, anticipatory moment in a dark apartment" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="shell hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Tension</p>
          <h1 id="hero-title">For couples exploring kink, BDSM, and power dynamics</h1>
          <p class="hero-lede">Articles, practical questions, role plays and scene guides for couples who want more trust, better play, and stronger erotic connection.</p>
          <div class="hero-actions">
            <a class="button" href="/free-checklist/">Get the free checklist <ArrowRight size={15} /></a>
            <a class="text-link" href="#playbooks">Explore the guides <ArrowRight size={14} /></a>
          </div>
          <p class="hero-trust"><ShieldCheck size={15} /> Consent-first education for adults. Not therapy. Not porn.</p>
        </div>
      </div>
    </section>

    <section id="how-it-works" class="simple-section steps-section">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Less guessing. More connection.</p>
          <h2>Start with what you<br /><em>both want.</em></h2>
        </div>
        <div class="steps-grid">
          {steps.map((step, index) => (
            <article>
              <span>0{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="checklist-feature">
      <div class="checklist-image"><img src="/images/lp/tension-checklist-v3.png" alt="A Tension notebook and pen beside a glass" loading="lazy" /></div>
      <div class="checklist-copy">
        <p class="eyebrow">Start here</p>
        <h2>Find out what<br /><em>you both want.</em></h2>
        <p>Ninety activities. Five possible answers. One easier way to start the conversation.</p>
        <ul>
          <li><Check size={16} /> Explore kink, sensory play, and power exchange</li>
          <li><Check size={16} /> Move beyond yes or no</li>
          <li><Check size={16} /> Complete it together, in real time</li>
        </ul>
        <a class="button" href="/free-checklist/">Get the free checklist <ArrowRight size={15} /></a>
        <small>Free and delivered discreetly.</small>
      </div>
    </section>

    <section id="mrd" class="mrd-section">
      <div class="mrd-image"><img src="/images/lp/tension-mrd-editorial-v1.jpg" alt="An open notebook, fountain pen, ribbon, and key in a private study" loading="lazy" /></div>
      <div class="mrd-copy">
        <p class="eyebrow">Meet your guide</p>
        <h2>Mr. D says the part<br /><em>most advice avoids.</em></h2>
        <p>Direct, kink-informed, and practical. Mr. D turns questions about desire, dominance, submission, boundaries, and erotic connection into language you can use together.</p>
        <blockquote>“You need better language for the parts of you that are already there.”</blockquote>
        <a class="text-link" href="/blog/">Read the Tension Journal <ArrowRight size={14} /></a>
        <small>Mr. D is an editorial coaching persona created by Tension.</small>
      </div>
    </section>

    <section id="playbooks" class="simple-section guides-section">
      <div class="shell">
        <div class="section-heading center">
          <p class="eyebrow">Talk. Play. Enjoy it together.</p>
          <h2>Choose your<br /><em>next step.</em></h2>
        </div>
        <div class="guide-grid">
          {guides.map((guide) => (
            <a class="guide-card" href={guide.href}>
              <div class="guide-image"><img src={guide.image} alt="" loading="lazy" /></div>
              <div class="guide-copy">
                <span>{guide.label}</span>
                <h3>{guide.title}</h3>
                <p>{guide.copy}</p>
                <b>{guide.cta} <ArrowRight size={14} /></b>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="playbooks-section">
      <div class="shell">
        <div class="playbooks-heading">
          <div>
            <p class="eyebrow">The Tension Scene Collection</p>
            <h2>Start with a frame.<br /><em>Build from there.</em></h2>
          </div>
          <p>Three levels of D/s scene guides for couples who want structure without losing the feeling.</p>
        </div>
        <div class="playbook-list">
          {playbooks.map(([level, title, href], index) => (
            <a href={href}>
              <span>0{index + 1} · {level}</span>
              <h3>{title}</h3>
              <ArrowRight size={17} />
            </a>
          ))}
        </div>
        <p class="scope-note">The current scene collections are written for a male Dominant/female submissive dynamic.</p>
      </div>
    </section>

    <section class="standards-section">
      <div class="shell standards-inner">
        <div>
          <p class="eyebrow">Our standard</p>
          <h2>Good play needs<br /><em>good preparation.</em></h2>
        </div>
        <p>Consent is active. Curiosity is not pressure. Every activity carries specific risks. Tension gives you practical education for the conversation before, during, and after the scene.</p>
      </div>
    </section>

    <section class="closing-section">
      <div class="narrow center">
        <p class="eyebrow">Your next move</p>
        <h2>Start with one<br /><em>honest conversation.</em></h2>
        <p>You do not need the perfect scene. You need a way to begin.</p>
        <a class="button" href="/free-checklist/">Get the free checklist <ArrowRight size={15} /></a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div><a class="wordmark" href="/">TENSION</a><p>Practical, erotic relationship education for couples.</p></div>
        <nav aria-label="Footer navigation"><a href="#how-it-works">How it works</a><a href="#mrd">Mr. D</a><a href="#playbooks">Guides</a><a href="/blog/">Journal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
        <a class="mail" href="mailto:hello@tension.app" aria-label="Email Tension"><Mail size={18} /></a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(html) { scroll-behavior: smooth; background: #050403; }
  :global(body) { background: #050403 !important; }
  .landing { --black:#050403; --black-soft:#0b0908; --panel:#100c0b; --ivory:#eee5da; --muted:#b7aa9e; --faint:#82766d; --gold:#c99a45; --gold-dark:#5d421c; --red:#a80f1b; color:var(--ivory); background:var(--black); overflow:hidden; font-family:Inter,sans-serif; }
  .shell { width:min(calc(100% - 48px),1180px); margin-inline:auto; }
  .narrow { width:min(calc(100% - 48px),760px); margin-inline:auto; }
  .center { text-align:center; }
  a { color:inherit; text-decoration:none; }
  em { color:var(--gold); font-weight:300; }
  h2 { font:300 clamp(38px,5vw,66px)/.98 Fraunces,serif; letter-spacing:-.035em; }
  .eyebrow { color:#d42a35; font:600 11px/1.3 Inter,sans-serif; letter-spacing:.19em; text-transform:uppercase; }
  .button { min-height:50px; padding:0 24px; display:inline-flex; align-items:center; justify-content:center; gap:14px; color:#fff6ed; background:linear-gradient(180deg,#c21725,#94101a); border:1px solid #d12634; font:600 10px/1 Inter,sans-serif; letter-spacing:.14em; text-transform:uppercase; transition:transform .2s,filter .2s; }
  .button:hover { transform:translateY(-2px); filter:brightness(1.12); }
  .button--small { min-height:38px; padding-inline:18px; font-size:8px; }
  .text-link { display:inline-flex; align-items:center; gap:10px; color:var(--gold); font:600 10px/1 Inter,sans-serif; letter-spacing:.12em; text-transform:uppercase; }
  .text-link:hover { color:#ebbd69; }
  .site-header { position:absolute; z-index:20; inset:0 0 auto; border-bottom:1px solid rgba(255,255,255,.08); background:linear-gradient(180deg,rgba(2,2,2,.85),rgba(2,2,2,.18)); }
  .header-inner { height:76px; display:flex; align-items:center; }
  .wordmark { color:var(--gold); font:400 20px/1 Fraunces,serif; letter-spacing:.28em; }
  .site-header nav { display:flex; gap:32px; margin-left:auto; margin-right:34px; }
  .site-header nav a,.site-footer nav a { color:#d2c8be; font:600 9px/1 Inter,sans-serif; letter-spacing:.14em; text-transform:uppercase; }
  .site-header nav a:hover,.site-footer nav a:hover { color:var(--gold); }
  .hero { position:relative; min-height:760px; isolation:isolate; display:flex; align-items:center; }
  .hero>img { position:absolute; z-index:-2; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; filter:saturate(.82) brightness(.82); }
  .hero-shade { position:absolute; z-index:-1; inset:0; background:linear-gradient(90deg,rgba(2,2,2,.97) 0%,rgba(2,2,2,.88) 28%,rgba(2,2,2,.3) 65%,rgba(2,2,2,.1) 100%),linear-gradient(180deg,rgba(0,0,0,.3),transparent 50%,#050403 100%); }
  .hero-inner { padding-top:76px; }
  .hero-copy { width:min(620px,58%); }
  .hero h1 { margin-top:24px; font:300 clamp(49px,6.3vw,86px)/.94 Fraunces,serif; letter-spacing:-.045em; text-shadow:0 4px 30px #000; }
  .hero-lede { max-width:600px; margin-top:30px; color:#d3c7bc; font:300 20px/1.55 Fraunces,serif; }
  .hero-actions { display:flex; align-items:center; gap:28px; margin-top:38px; }
  .hero-trust { margin-top:25px; color:#a99b90; display:flex; align-items:center; gap:9px; font-size:11px; }
  .simple-section { padding:100px 0; }
  .steps-section { background:var(--black-soft); border-top:1px solid #251b12; border-bottom:1px solid #251b12; }
  .section-heading h2 { margin-top:18px; }
  .steps-grid { display:grid; grid-template-columns:repeat(3,1fr); margin-top:55px; border-top:1px solid #3b2a18; border-bottom:1px solid #3b2a18; }
  .steps-grid article { min-height:250px; padding:30px 30px 34px; border-right:1px solid #3b2a18; }
  .steps-grid article:last-child { border-right:0; }
  .steps-grid span { color:var(--gold); font:300 28px/1 Fraunces,serif; }
  .steps-grid h3 { margin-top:55px; font:300 27px/1.05 Fraunces,serif; }
  .steps-grid p { margin-top:15px; color:var(--muted); font-size:13px; line-height:1.6; }
  .checklist-feature { display:grid; grid-template-columns:1fr 1fr; background:#0d0a08; }
  .checklist-image { min-height:540px; overflow:hidden; }
  .checklist-image img { width:100%; height:100%; object-fit:cover; filter:saturate(.75) brightness(.78); }
  .checklist-copy { padding:90px clamp(38px,8vw,115px); align-self:center; }
  .checklist-copy h2 { margin-top:18px; }
  .checklist-copy>p:not(.eyebrow) { margin-top:25px; color:var(--muted); font:300 20px/1.55 Fraunces,serif; }
  .checklist-copy ul { display:grid; gap:14px; margin:28px 0 34px; }
  .checklist-copy li { display:flex; align-items:center; gap:12px; color:var(--muted); font-size:13px; }
  .checklist-copy li :global(svg) { color:var(--gold); flex:none; }
  .checklist-copy small { display:block; margin-top:14px; color:var(--faint); font-size:10px; }
  .mrd-section { display:grid; grid-template-columns:1fr 1fr; background:#100b09; }
  .mrd-image { min-height:560px; overflow:hidden; }
  .mrd-image img { width:100%; height:100%; object-fit:cover; filter:saturate(.78) brightness(.77); }
  .mrd-copy { padding:85px clamp(38px,8vw,115px); align-self:center; }
  .mrd-copy h2 { margin-top:18px; }
  .mrd-copy>p:not(.eyebrow) { margin-top:24px; color:var(--muted); font:300 18px/1.65 Fraunces,serif; }
  .mrd-copy blockquote { margin:30px 0; padding-left:20px; border-left:1px solid var(--gold); color:#e7d9cd; font:italic 300 20px/1.45 Fraunces,serif; }
  .mrd-copy small { display:block; margin-top:30px; color:#a99b90; font-size:12px; line-height:1.55; }
  .guides-section { background:#070605; }
  .guide-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:55px; }
  .guide-card { background:#0d0a08; border:1px solid #282018; transition:transform .2s,border-color .2s; }
  .guide-card:hover { transform:translateY(-4px); border-color:var(--gold-dark); }
  .guide-image { height:250px; overflow:hidden; }
  .guide-image img { width:100%; height:100%; object-fit:cover; filter:brightness(.72) saturate(.7); transition:transform .4s; }
  .guide-card:hover img { transform:scale(1.03); }
  .guide-copy { min-height:245px; padding:26px; display:flex; flex-direction:column; }
  .guide-copy>span { color:#d52d39; font-size:9px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; }
  .guide-copy h3 { margin-top:14px; font:300 27px/1.08 Fraunces,serif; }
  .guide-copy p { margin-top:16px; color:var(--muted); font-size:13px; line-height:1.6; }
  .guide-copy b { margin-top:auto; padding-top:24px; color:var(--gold); display:flex; align-items:center; gap:10px; font-size:9px; letter-spacing:.12em; text-transform:uppercase; }
  .playbooks-section { padding:95px 0 105px; background:#0b0807; border-top:1px solid #2e2015; }
  .playbooks-heading { display:flex; align-items:end; justify-content:space-between; gap:50px; }
  .playbooks-heading>p { width:min(390px,40%); color:var(--muted); line-height:1.65; }
  .playbook-list { display:grid; grid-template-columns:repeat(3,1fr); margin-top:50px; border-top:1px solid #3b2a18; border-bottom:1px solid #3b2a18; }
  .playbook-list a { min-height:180px; padding:27px; display:grid; grid-template-columns:1fr auto; align-content:space-between; border-right:1px solid #3b2a18; }
  .playbook-list a:last-child { border-right:0; }
  .playbook-list a:hover h3,.playbook-list a:hover :global(svg) { color:var(--gold); }
  .playbook-list span { grid-column:1/-1; color:#d52d39; font-size:9px; font-weight:600; letter-spacing:.16em; text-transform:uppercase; }
  .playbook-list h3 { font:300 28px/1.05 Fraunces,serif; }
  .playbook-list :global(svg) { align-self:end; color:var(--muted); }
  .scope-note { margin-top:18px; color:#82766d; font-size:10px; }
  .standards-section { padding:70px 0; background:#100b09; border-top:1px solid #2e2015; border-bottom:1px solid #2e2015; }
  .standards-inner { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }
  .standards-inner>p { color:var(--muted); font:300 18px/1.65 Fraunces,serif; }
  .closing-section { padding:110px 0; background:radial-gradient(circle at 50% 30%,#23120f,#050403 62%); }
  .closing-section h2 { margin-top:18px; }
  .closing-section>div>p:not(.eyebrow) { margin:25px 0 32px; color:var(--muted); font:300 19px/1.5 Fraunces,serif; }
  .site-footer { padding:45px 0; border-top:1px solid #2d2117; }
  .footer-inner { display:grid; grid-template-columns:1fr auto 24px; gap:45px; align-items:center; }
  .footer-inner>div p { margin-top:12px; color:var(--faint); font-size:10px; }
  .site-footer nav { display:flex; flex-wrap:wrap; justify-content:center; gap:23px; }
  .mail { color:var(--gold); }
  a:focus-visible { outline:1px solid var(--gold); outline-offset:4px; }
  @media (max-width:900px) {
    .site-header nav { display:none; }
    .site-header .button { margin-left:auto; }
    .hero { min-height:730px; align-items:end; padding-bottom:70px; }
    .hero-copy { width:min(700px,82%); }
    .hero-shade { background:linear-gradient(90deg,rgba(2,2,2,.92),rgba(2,2,2,.35)),linear-gradient(180deg,rgba(0,0,0,.1),rgba(5,4,3,.94) 90%); }
    .checklist-feature,.mrd-section,.standards-inner { grid-template-columns:1fr; }
    .checklist-image,.mrd-image { min-height:430px; }
    .guide-grid,.playbook-list { grid-template-columns:1fr; }
    .guide-card { display:grid; grid-template-columns:.8fr 1.2fr; }
    .guide-image { height:100%; min-height:300px; }
    .playbook-list a { border-right:0; border-bottom:1px solid #3b2a18; }
    .playbook-list a:last-child { border-bottom:0; }
    .standards-inner { gap:28px; }
    .footer-inner { grid-template-columns:1fr auto; }
    .site-footer nav { display:none; }
  }
  @media (max-width:640px) {
    .shell,.narrow { width:min(calc(100% - 32px),1180px); }
    .site-header .button { min-height:35px; padding-inline:12px; font-size:7px; }
    .wordmark { font-size:17px; }
    .hero { min-height:760px; padding-bottom:48px; }
    .hero>img { object-position:62% center; }
    .hero-copy { width:100%; }
    .hero h1 { font-size:clamp(43px,13vw,62px); }
    .hero-lede { font-size:17px; }
    .hero-actions { align-items:flex-start; flex-direction:column; }
    .hero-trust { align-items:flex-start; line-height:1.5; }
    .simple-section,.closing-section { padding:78px 0; }
    .steps-grid { grid-template-columns:1fr; }
    .steps-grid article { min-height:0; border-right:0; border-bottom:1px solid #3b2a18; }
    .steps-grid article:last-child { border-bottom:0; }
    .steps-grid h3 { margin-top:38px; }
    .checklist-copy,.mrd-copy { padding:65px 24px; }
    .guide-card { display:block; }
    .guide-image { height:260px; min-height:0; }
    .playbooks-section { padding:78px 0; }
    .playbooks-heading { align-items:flex-start; flex-direction:column; gap:24px; }
    .playbooks-heading>p { width:100%; }
    .standards-section { padding:65px 0; }
    .footer-inner { gap:25px; }
  }
</style>
