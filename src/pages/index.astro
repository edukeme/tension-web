---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight, Camera, Check, Mail } from '@lucide/astro';

export const prerender = true;

const guides = [
  {
    href: '/negotiation-workbook/',
    title: 'The Language Field Guide',
    line: 'Speak clearly. Listen deeply.',
    description: 'Practical frameworks for better conversations and repair.',
    image: '/images/lp/tension-guide-language-v3.png',
  },
  {
    href: '/21-scenes/',
    title: 'The Rituals Playbook',
    line: 'Small rituals. Big results.',
    description: 'Design simple rituals that build safety and closeness.',
    image: '/images/lp/tension-guide-rituals-v3.png',
  },
  {
    href: '/brat-playbook/',
    title: 'The Intimacy Workbook',
    line: 'Explore with care.',
    description: 'Guided exercises for desire, boundaries, and pleasure.',
    image: '/images/lp/tension-guide-intimacy-v3.png',
  },
];

const journal = [
  {
    href: '/blog/can-be-great-boyfriend-and-dominant/',
    title: 'Connection, not perfection',
    line: 'Why presence matters more than performance.',
    image: '/images/lp/tension-journal-connection-v3.png',
  },
  {
    href: '/blog/bdsm-couples-test/',
    title: '3 questions that change everything',
    line: 'A weekly check-in that brings you closer.',
    image: '/images/lp/tension-journal-questions-v3.png',
  },
  {
    href: '/blog/how-to-start-bdsm-as-a-couple/',
    title: 'Desire grows in the details',
    line: 'Small moments. Consistent care. Lasting impact.',
    image: '/images/lp/tension-journal-desire-v3.png',
  },
];
---

<BaseLayout title="Intentional Intimacy for Couples and Singles" description="Language, structure, and consent-first tools for a more intentional relationship." canonical="/" hideChrome={true}>
  <main class="landing">
    <header class="site-header">
      <div class="page-shell header-inner">
        <a class="wordmark" href="/" aria-label="Tension home">TENSION</a>
        <nav aria-label="Primary navigation">
          <a href="/about/">About</a>
          <a href="#approach">Approach</a>
          <a href="#guides">Tools</a>
          <a href="#guides">Guides</a>
          <a href="/blog/">Journal</a>
        </nav>
        <a class="button button--header" href="/free-checklist">Get the checklist</a>
      </div>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <img src="/images/lp/tension-hero-v3.jpg" alt="An adult couple sharing a quiet moment on a sofa" fetchpriority="high" />
      <div class="hero-shade"></div>
      <div class="hero-content">
        <h1 id="hero-title">The relationship<br /><em>behind the scene.</em></h1>
        <p>More <em>intention.</em> More <em>language.</em> More <em>trust.</em></p>
        <a class="button hero-button" href="/free-checklist">Get the free checklist <ArrowRight size={13} strokeWidth={1.25} /></a>
      </div>
    </section>

    <section id="approach" class="approach">
      <div class="page-shell center">
        <p class="kicker">Our approach</p>
        <h2>Stronger connection<br /><em>is built, not left to chance.</em></h2>
        <div class="ornament" aria-hidden="true"><span></span><i></i><span></span></div>
        <p class="approach-copy">TENSION gives you the language, structure, and tools<br />to create a relationship that feels safe, curious, and deeply connected.</p>
      </div>
    </section>

    <section class="process" aria-labelledby="process-title">
      <div class="page-shell">
        <p id="process-title" class="kicker center">How it works</p>
        <div class="process-grid">
          <article><strong>01</strong><h3>Find the words</h3><p>Name what matters.<br />Speak clearly.<br />Listen deeply.</p></article>
          <div class="process-line" aria-hidden="true"><i></i></div>
          <article><strong>02</strong><h3>Build the frame</h3><p>Create rituals and agreements<br />that hold in real life.</p></article>
          <div class="process-line" aria-hidden="true"><i></i></div>
          <article><strong>03</strong><h3>Explore with care</h3><p>Move at a pace that feels safe,<br />curious, and connected.</p></article>
        </div>
      </div>
    </section>

    <section class="checklist">
      <div class="checklist-grid">
        <div class="checklist-image"><img src="/images/lp/tension-checklist-v3.png" alt="A Tension notebook and pen beside a glass" loading="lazy" /></div>
        <div class="checklist-copy">
          <p class="kicker">Free resource</p>
          <h2>The Couples Checklist</h2>
          <em>90 activities to spark better conversations<br />and deeper connection.</em>
          <ul>
            <li><Check size={15} strokeWidth={1.35} /> 10 conversation starters</li>
            <li><Check size={15} strokeWidth={1.35} /> Consent and comfort guide</li>
            <li><Check size={15} strokeWidth={1.35} /> Rituals that strengthen connection</li>
            <li><Check size={15} strokeWidth={1.35} /> A simple weekly check-in</li>
          </ul>
          <div class="checklist-action">
            <div class="ninety"><strong>90</strong><span>Activities</span></div>
            <div><a class="button" href="/free-checklist">Get the checklist <ArrowRight size={13} strokeWidth={1.25} /></a><small>No spam. Unsubscribe anytime.</small></div>
          </div>
        </div>
      </div>
    </section>

    <section id="guides" class="content-section guides">
      <div class="page-shell">
        <p class="kicker center">Guides</p>
        <div class="card-grid">
          {guides.map((guide) => (
            <a class="content-card" href={guide.href}>
              <div class="card-image"><img src={guide.image} alt="" loading="lazy" /></div>
              <div class="card-copy">
                <h3>{guide.title}</h3>
                <em>{guide.line}</em>
                <p>{guide.description}</p>
                <span>Learn more <ArrowRight size={14} strokeWidth={1.2} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="content-section journal">
      <div class="page-shell">
        <p class="kicker center">Journal</p>
        <div class="card-grid">
          {journal.map((post) => (
            <a class="content-card journal-card" href={post.href}>
              <div class="card-image"><img src={post.image} alt="" loading="lazy" /></div>
              <div class="card-copy">
                <h3>{post.title}</h3>
                <em>{post.line}</em>
                <span>Read more <ArrowRight size={14} strokeWidth={1.2} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="closing">
      <div class="page-shell center">
        <h2>You only need<br /><em>a next conversation.</em></h2>
        <a class="button" href="/free-checklist">Get the free checklist <ArrowRight size={13} strokeWidth={1.25} /></a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="page-shell footer-inner">
        <a class="wordmark" href="/">TENSION</a>
        <nav aria-label="Footer navigation"><a href="/about/">About</a><a href="#approach">Approach</a><a href="#guides">Tools</a><a href="#guides">Guides</a><a href="/blog/">Journal</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></nav>
        <div class="social"><span aria-label="Instagram"><Camera size={15} strokeWidth={1.2} /></span><a href="mailto:hello@tension.com" aria-label="Email Tension"><Mail size={15} strokeWidth={1.2} /></a></div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  :global(html) { scroll-behavior:smooth; background:#020202; }
  .landing {
    --black:#020202;
    --ivory:#e7dfd6;
    --muted:#bdb4ab;
    --gold:#b77c02;
    --gold-dark:#72500a;
    --red:#a70b15;
    --red-bright:#cb111e;
    background:var(--black); color:var(--ivory); overflow:hidden; font-family:Inter,sans-serif;
  }
  .page-shell { width:min(calc(100% - 30px),718px); margin-inline:auto; }
  .center { text-align:center; }
  a { text-decoration:none; }
  .site-header { position:absolute; z-index:10; inset:0 0 auto; height:54px; background:linear-gradient(180deg,rgba(2,2,2,.82),transparent); }
  .header-inner { height:54px; display:flex; align-items:center; }
  .wordmark { color:var(--gold); font:400 16px/1 Fraunces,serif; letter-spacing:.25em; }
  .site-header nav { display:flex; gap:29px; margin-left:auto; margin-right:30px; }
  .site-header nav a,.site-footer nav a { color:#d4ccc4; font:600 7px/1 Inter,sans-serif; letter-spacing:.15em; text-transform:uppercase; transition:color .2s; }
  .site-header nav a:hover,.site-footer nav a:hover { color:var(--gold); }
  .button { min-height:34px; padding:0 20px; display:inline-flex; align-items:center; justify-content:center; gap:15px; color:#f4ece4; background:linear-gradient(180deg,#ba101a,#960912); border:1px solid #b90e19; font:600 7px/1 Inter,sans-serif; letter-spacing:.17em; text-transform:uppercase; transition:filter .2s,transform .2s; }
  .button:hover { filter:brightness(1.18); transform:translateY(-1px); }
  .button--header { min-height:29px; padding-inline:18px; }
  .hero { position:relative; isolation:isolate; height:540px; }
  .hero>img { position:absolute; z-index:-2; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 43%; filter:brightness(.73) saturate(.76) sepia(.08); }
  .hero-shade { position:absolute; z-index:-1; inset:0; background:radial-gradient(ellipse 54% 55% at 50% 44%,transparent 0,rgba(0,0,0,.12) 65%,rgba(0,0,0,.62) 100%),linear-gradient(180deg,rgba(0,0,0,.02) 40%,rgba(0,0,0,.2) 66%,#020202 100%); }
  .hero-content { position:absolute; inset:auto 15px 38px; text-align:center; }
  .hero h1 { color:var(--ivory); font:300 54px/.91 Fraunces,serif; letter-spacing:-.035em; text-shadow:0 2px 18px #000; }
  .hero h1 em,.approach h2 em,.closing h2 em { color:var(--gold); font-style:italic; font-weight:300; }
  .hero-content>p { margin-top:20px; color:#d0c7be; font:italic 15px/1 Fraunces,serif; }
  .hero-content>p em { color:var(--gold); }
  .hero-button { margin-top:30px; min-width:188px; }
  .kicker { color:var(--red-bright); font:600 7px/1 Inter,sans-serif; letter-spacing:.24em; text-transform:uppercase; }
  .approach { height:201px; padding-top:27px; }
  .approach h2 { margin-top:15px; font:300 34px/1.05 Fraunces,serif; letter-spacing:-.018em; }
  .ornament { display:flex; align-items:center; justify-content:center; gap:8px; width:200px; margin:16px auto 10px; }
  .ornament span { height:1px; flex:1; background:linear-gradient(90deg,transparent,var(--gold-dark)); }
  .ornament span:last-child { background:linear-gradient(90deg,var(--gold-dark),transparent); }
  .ornament i { width:5px; height:5px; border:1px solid var(--gold); transform:rotate(45deg); }
  .approach-copy { color:#bcb3aa; font:400 11px/1.5 Fraunces,serif; }
  .process { height:174px; padding-top:13px; }
  .process-grid { margin-top:16px; display:grid; grid-template-columns:1fr 1fr 1fr 1fr 1fr; align-items:start; }
  .process-grid article { text-align:center; }
  .process-grid strong { color:var(--gold); font:300 35px/1 Fraunces,serif; }
  .process-grid h3 { margin-top:8px; font:300 15px/1 Fraunces,serif; }
  .process-grid p { margin-top:7px; color:#c2b9b0; font:400 10px/1.35 Fraunces,serif; }
  .process-line { height:1px; margin-top:20px; background:var(--gold-dark); position:relative; }
  .process-line::before,.process-line::after { content:''; position:absolute; top:-2px; width:4px; height:4px; border-radius:50%; background:var(--gold); }
  .process-line::before { left:0; } .process-line::after { right:0; }
  .checklist { height:333px; }
  .checklist-grid { height:333px; display:grid; grid-template-columns:48% 52%; }
  .checklist-image { overflow:hidden; }
  .checklist-image img { width:100%; height:100%; object-fit:cover; transform:scale(1.035); filter:brightness(.78) saturate(.72) sepia(.06); }
  .checklist-copy { padding:15px 31px 10px 38px; }
  .checklist-copy h2 { margin-top:12px; font:300 28px/1 Fraunces,serif; }
  .checklist-copy>em { display:block; margin-top:7px; color:var(--gold); font:italic 14px/1.25 Fraunces,serif; }
  .checklist-copy ul { display:grid; gap:8px; margin-top:18px; }
  .checklist-copy li { color:#c9c0b7; font:400 10px/1 Fraunces,serif; display:flex; align-items:center; gap:8px; }
  .checklist-copy li :global(svg) { color:var(--gold); border:1px solid var(--gold); border-radius:50%; padding:2px; flex:none; }
  .checklist-action { display:flex; align-items:center; gap:24px; margin-top:25px; }
  .ninety { min-width:85px; }
  .ninety strong { display:block; color:var(--gold); font:300 70px/.68 Fraunces,serif; letter-spacing:-.055em; }
  .ninety span { display:block; margin-top:12px; color:var(--gold); font:500 10px/1 Inter,sans-serif; letter-spacing:.2em; text-transform:uppercase; }
  .checklist-action small { display:block; margin-top:10px; color:#8d857d; font:400 8px/1 Fraunces,serif; text-align:center; }
  .content-section { padding-top:22px; }
  .guides { height:328px; }
  .card-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-top:13px; }
  .content-card { min-width:0; color:inherit; display:flex; flex-direction:column; transition:transform .2s; }
  .content-card:hover { transform:translateY(-2px); }
  .card-image { height:143px; overflow:hidden; background:#080704; }
  .card-image img { width:100%; height:100%; object-fit:cover; object-position:center bottom; transform:scale(1.38); transform-origin:center bottom; filter:brightness(.78) saturate(.72) sepia(.08); transition:transform .4s; }
  .content-card:hover .card-image img { transform:scale(1.42); }
  .card-copy { padding:13px 11px 0; }
  .card-copy h3 { font:300 15.5px/1.08 Fraunces,serif; }
  .card-copy em { display:block; margin-top:5px; color:var(--gold); font:italic 11px/1.2 Fraunces,serif; }
  .card-copy p { margin-top:11px; color:#bbb2a9; font:400 9px/1.42 Fraunces,serif; min-height:39px; }
  .card-copy span { margin-top:14px; color:var(--gold); display:flex; align-items:center; gap:10px; font:600 7px/1 Inter,sans-serif; letter-spacing:.17em; text-transform:uppercase; }
  .journal { height:293px; padding-top:0; }
  .journal .card-grid { margin-top:12px; }
  .journal-card .card-image { height:137px; }
  .journal-card .card-copy { padding-top:14px; }
  .journal-card .card-copy span { margin-top:15px; }
  .closing { height:160px; padding-top:15px; }
  .closing h2 { font:300 29px/1.02 Fraunces,serif; }
  .closing .button { margin-top:17px; }
  .site-footer { height:74px; border-top:1px solid #332404; }
  .footer-inner { height:74px; display:flex; align-items:center; }
  .site-footer nav { display:flex; gap:24px; margin:auto; }
  .social { color:var(--gold); display:flex; align-items:center; gap:14px; }
  .social span,.social a { color:var(--gold); display:flex; }
  a:focus-visible,button:focus-visible { outline:1px solid var(--gold); outline-offset:4px; }
  @media (max-width:680px) {
    .page-shell { width:min(calc(100% - 28px),718px); }
    .site-header nav { display:none; }
    .site-header .button { margin-left:auto; }
    .hero { height:640px; }
    .hero>img { object-position:54% center; }
    .hero-content { bottom:44px; }
    .hero h1 { font-size:clamp(42px,13vw,58px); }
    .approach,.process,.checklist,.guides,.journal,.closing,.site-footer { height:auto; }
    .approach { padding:48px 0 40px; }
    .approach h2 { font-size:30px; }
    .approach-copy br { display:none; }
    .process { padding:25px 0 48px; }
    .process-grid { grid-template-columns:1fr; gap:14px; width:min(100%,290px); margin-inline:auto; margin-top:25px; }
    .process-line { width:1px; height:24px; margin:0 auto; }
    .process-line::before,.process-line::after { left:-2px; right:auto; }
    .process-line::before { top:0; } .process-line::after { top:auto; bottom:0; }
    .checklist-grid { height:auto; grid-template-columns:1fr; }
    .checklist-image { height:360px; }
    .checklist-copy { padding:38px 28px 45px; }
    .checklist-action { justify-content:space-between; }
    .card-grid { grid-template-columns:1fr; gap:34px; }
    .content-section { padding:40px 0; }
    .card-image,.journal-card .card-image { height:240px; }
    .card-copy { padding-inline:8px; }
    .card-copy h3 { font-size:22px; }
    .card-copy p { min-height:0; font-size:11px; }
    .journal-card .card-copy h3 { max-width:none; }
    .closing { padding:34px 0 40px; }
    .footer-inner { min-height:74px; flex-wrap:wrap; justify-content:center; gap:17px; padding:18px 0; }
    .site-footer nav { order:3; width:100%; justify-content:center; gap:14px; flex-wrap:wrap; }
  }
  @media (prefers-reduced-motion:reduce) { :global(*) { scroll-behavior:auto !important; transition-duration:.01ms !important; } }
</style>
