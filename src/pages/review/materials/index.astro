---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { REVIEW_MATERIALS } from '@/lib/product-review';

export const prerender = true;

const materials = await getCollection('productMaterials');
const items = materials
  .map(material => ({ id: material.id, ...REVIEW_MATERIALS[material.id] }))
  .filter(item => item.title)
  .sort((a, b) => a.title.localeCompare(b.title));
---

<BaseLayout
  title="Paid Materials — Review Library"
  description="Ungated review copies of Tension's paid product manuscripts."
  noIndex={true}
>
  <div class="max-w-5xl mx-auto px-6 py-16 md:py-24">
    <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#D4213D]">Testing library</p>
    <h1 class="font-serif text-4xl md:text-6xl text-white mt-4 mb-5">Paid materials</h1>
    <p class="max-w-2xl text-gray-400 leading-relaxed mb-12">
      Full, ungated working manuscripts for review. These pages are excluded from search indexing and do not require checkout.
    </p>

    <div class="grid md:grid-cols-2 gap-5">
      {items.map(item => (
        <a href={`/review/materials/${item.id}/`} class="block rounded-2xl border border-white/10 bg-white/[0.03] p-6 hover:border-[#D4213D]/60 hover:-translate-y-0.5 transition-all">
          <span class="text-[10px] font-bold tracking-widest uppercase text-[#D4213D]">{item.status === 'future' ? 'Future product' : 'In catalog'}</span>
          <h2 class="font-serif text-2xl text-white mt-3 mb-2">{item.title}</h2>
          <p class="text-sm text-gray-500">{item.format}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
