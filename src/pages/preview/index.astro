---
export const prerender = true;

const products = [
  { slug: '7scenes-vol1',          title: '7 Scenes: First Explorations',               type: 'PDF',   price: '€29',    lines: 2834 },
  { slug: '7scenes-vol2',          title: '7 Scenes: The Deep Game',                    type: 'PDF',   price: '€29',    lines: 3280 },
  { slug: '7scenes-vol3',          title: '7 Scenes: The Edge',                         type: 'PDF',   price: '€29',    lines: 3225 },
  { slug: '21-scenes-bundle',      title: '21 Scenes: The Complete Collection',         type: 'PDF',   price: '€59',    lines: 9278 },
  { slug: 'negotiation-workbook', title: 'Tension Negotiation Workbook',               type: 'PDF',   price: '€9.90',  lines: 994  },
  { slug: 'verbal-arsenal',       title: 'The Verbal Arsenal',                         type: 'PDF',   price: '€9.90',  lines: 797  },
  { slug: 'brat-playbook',        title: 'The Brat Submissive Playbook',               type: 'PDF',   price: '€14.90', lines: 535  },
  { slug: 'erotic-tales',         title: '10 Erotic Tales for Couples',                type: 'Audio', price: '€19.90', lines: 1445 },
  { slug: 'free-checklist',       title: 'The Couples Kink Discovery Checklist',       type: 'PDF',   price: 'Free',   lines: 369  },
  { slug: 'dominant-handbook',   title: "The Dominant's Handbook",                    type: 'PDF',   price: '€29',    lines: 1580 },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Content Preview — Tension</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
      background: #0A0A0A;
      color: #EBEBEB;
      min-height: 100vh;
      padding: 48px 24px;
    }
    .header {
      max-width: 800px;
      margin: 0 auto 48px;
    }
    .header h1 {
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #D4213D;
      margin-bottom: 8px;
    }
    .header p {
      font-size: 13px;
      color: #666;
    }
    .grid {
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #111;
      border: 1px solid #1E1E1E;
      padding: 20px 24px;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s, background 0.15s;
    }
    .card:hover {
      border-color: #D4213D;
      background: #141414;
    }
    .card-left { display: flex; align-items: center; gap: 16px; }
    .badge {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: 2px;
      flex-shrink: 0;
    }
    .badge-pdf { background: #D4213D22; color: #D4213D; border: 1px solid #D4213D44; }
    .badge-audio { background: #2563EB22; color: #60A5FA; border: 1px solid #2563EB44; }
    .card-title {
      font-size: 15px;
      font-weight: 500;
      color: #EBEBEB;
    }
    .card-right { display: flex; align-items: center; gap: 20px; flex-shrink: 0; }
    .card-meta { font-size: 12px; color: #444; }
    .card-price { font-size: 13px; font-weight: 600; color: #888; }
    .card-arrow { color: #333; font-size: 16px; }
    .card:hover .card-arrow { color: #D4213D; }
  </style>
</head>
<body>
  <div class="header">
    <h1>Content Preview</h1>
    <p>Review each product before PDF/audio production. None of these are live to customers.</p>
  </div>
  <div class="grid">
    {products.map(p => (
      <a class="card" href={`/preview/${p.slug}`}>
        <div class="card-left">
          <span class={`badge ${p.type === 'PDF' ? 'badge-pdf' : 'badge-audio'}`}>{p.type}</span>
          <span class="card-title">{p.title}</span>
        </div>
        <div class="card-right">
          <span class="card-meta">{p.lines.toLocaleString()} lines</span>
          <span class="card-price">{p.price}</span>
          <span class="card-arrow">→</span>
        </div>
      </a>
    ))}
  </div>
</body>
</html>
