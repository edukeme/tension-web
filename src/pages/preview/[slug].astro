---
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export const prerender = true;

const PRODUCTS: Record<string, { title: string; file: string; type: string; price: string }> = {
  '7scenes-vol1': {
    title: '7 Scenes: First Explorations',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_7scenes-vol1-beginner.md',
    type: 'PDF',
    price: '€29',
  },
  '7scenes-vol2': {
    title: '7 Scenes: The Deep Game',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_7scenes-vol2-intermediate.md',
    type: 'PDF',
    price: '€29',
  },
  '7scenes-vol3': {
    title: '7 Scenes: The Edge',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_7scenes-vol3-advanced.md',
    type: 'PDF',
    price: '€29',
  },
  '21-scenes-bundle': {
    title: '21 Scenes: The Complete Collection',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_21-scenes.md',
    type: 'PDF',
    price: '€59',
  },
  'negotiation-workbook': {
    title: 'Tension Negotiation Workbook',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_negotiation-workbook.md',
    type: 'PDF',
    price: '€9.90',
  },
  'verbal-arsenal': {
    title: 'The Verbal Arsenal',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_verbal-arsenal.md',
    type: 'PDF',
    price: '€9.90',
  },
  'brat-playbook': {
    title: 'The Brat Submissive Playbook',
    file: '/Users/gaudi/HERMES/Tension/products/pdf_brat-playbook.md',
    type: 'PDF',
    price: '€14.90',
  },
  'erotic-tales': {
    title: '10 Erotic Tales for Couples',
    file: '/Users/gaudi/HERMES/Tension/products/audio_erotic-tales-scripts.md',
    type: 'Audio Script',
    price: '€19.90',
  },
  'free-checklist': {
    title: 'The Couples Kink Discovery Checklist',
    file: '/Users/gaudi/HERMES/Tension/products/lead-magnet_bdsm-checklist.md',
    type: 'PDF',
    price: 'Free',
  },
  'dominant-handbook': {
    title: "The Dominant's Handbook",
    file: '/Users/gaudi/HERMES/Tension/products/pdf_dominant-handbook.md',
    type: 'PDF',
    price: '€29',
  },
};

export function getStaticPaths() {
  return [
    '7scenes-vol1',
    '7scenes-vol2',
    '7scenes-vol3',
    '21-scenes-bundle',
    'negotiation-workbook',
    'verbal-arsenal',
    'brat-playbook',
    'erotic-tales',
    'free-checklist',
    'dominant-handbook',
  ].map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = PRODUCTS[slug];

// Strip YAML frontmatter if present
let raw = readFileSync(product.file, 'utf-8');
if (raw.startsWith('---')) {
  const end = raw.indexOf('---', 3);
  if (end !== -1) raw = raw.slice(end + 3).trimStart();
}

const html = await marked(raw, { breaks: false });

const allSlugs = Object.keys(PRODUCTS);
const currentIndex = allSlugs.indexOf(slug);
const prev = currentIndex > 0 ? allSlugs[currentIndex - 1] : null;
const next = currentIndex < allSlugs.length - 1 ? allSlugs[currentIndex + 1] : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{product.title} — Preview</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #1A1A1A;
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
      min-height: 100vh;
      color: #111;
    }

    /* Top nav bar */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: #0A0A0A;
      border-bottom: 1px solid #1E1E1E;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
    .topbar-left { display: flex; align-items: center; gap: 16px; }
    .back-link {
      font-size: 12px;
      color: #555;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .back-link:hover { color: #D4213D; }
    .topbar-title {
      font-size: 13px;
      color: #888;
      font-weight: 500;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 400px;
    }
    .topbar-right { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
    .badge {
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 3px 8px; border-radius: 2px;
      background: #D4213D22; color: #D4213D; border: 1px solid #D4213D44;
    }
    .price-tag { font-size: 13px; font-weight: 600; color: #666; }
    .nav-btn {
      font-size: 12px; color: #555; text-decoration: none; font-weight: 600;
      padding: 4px 10px; border: 1px solid #1E1E1E; border-radius: 2px;
    }
    .nav-btn:hover { color: #EBEBEB; border-color: #444; }

    /* Page wrapper — simulates a document */
    .page-outer {
      padding: 48px 24px 80px;
      display: flex;
      justify-content: center;
    }
    .page-doc {
      background: #FAFAF8;
      max-width: 780px;
      width: 100%;
      padding: 72px 80px;
      box-shadow: 0 4px 40px rgba(0,0,0,0.5);
      min-height: 100vh;
    }

    /* Document typography */
    .doc h1 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 28px;
      font-weight: 700;
      line-height: 1.2;
      color: #111;
      margin-bottom: 8px;
    }
    .doc h2 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 20px;
      font-weight: 700;
      color: #111;
      margin-top: 48px;
      margin-bottom: 16px;
      padding-top: 32px;
      border-top: 1px solid #E0E0E0;
    }
    .doc h2:first-of-type { border-top: none; padding-top: 0; margin-top: 32px; }
    .doc h3 {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 16px;
      font-weight: 700;
      color: #222;
      margin-top: 32px;
      margin-bottom: 12px;
    }
    .doc h4 {
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #B22;
      margin-top: 24px;
      margin-bottom: 8px;
    }
    .doc p {
      font-size: 15px;
      line-height: 1.75;
      color: #222;
      margin-bottom: 16px;
    }
    .doc ul, .doc ol {
      margin: 0 0 16px 24px;
    }
    .doc li {
      font-size: 15px;
      line-height: 1.7;
      color: #222;
      margin-bottom: 6px;
    }
    .doc hr {
      border: none;
      border-top: 1px solid #E0E0E0;
      margin: 40px 0;
    }
    .doc blockquote {
      border-left: 3px solid #C41;
      padding: 12px 20px;
      margin: 24px 0;
      background: #FFF8F5;
      border-radius: 0 2px 2px 0;
    }
    .doc blockquote p {
      font-style: italic;
      color: #444;
      margin-bottom: 0;
    }
    .doc strong { font-weight: 700; color: #111; }
    .doc em { font-style: italic; }
    .doc code {
      font-family: monospace;
      font-size: 13px;
      background: #F0F0EE;
      padding: 2px 6px;
      border-radius: 2px;
      color: #333;
    }
    .doc table {
      width: 100%;
      border-collapse: collapse;
      margin: 24px 0;
      font-size: 14px;
    }
    .doc th {
      text-align: left;
      padding: 8px 12px;
      background: #F0F0EE;
      font-weight: 700;
      border: 1px solid #DDD;
      color: #222;
    }
    .doc td {
      padding: 8px 12px;
      border: 1px solid #E0E0E0;
      color: #333;
      vertical-align: top;
    }
    .doc tr:nth-child(even) td { background: #FAFAFA; }

    /* Footer nav */
    .footer-nav {
      max-width: 780px;
      margin: 32px auto 0;
      display: flex;
      justify-content: space-between;
      padding: 0 4px;
    }
    .footer-nav a {
      font-size: 12px; color: #666; text-decoration: none; font-weight: 600;
      padding: 8px 16px; border: 1px solid #333; border-radius: 2px; background: #111;
    }
    .footer-nav a:hover { color: #EBEBEB; border-color: #666; }
    .footer-nav span { font-size: 11px; color: #444; align-self: center; }

    @media (max-width: 700px) {
      .page-doc { padding: 40px 24px; }
      .topbar-title { display: none; }
    }
  </style>
</head>
<body>

  <div class="topbar">
    <div class="topbar-left">
      <a class="back-link" href="/preview">← All products</a>
      <span class="topbar-title">{product.title}</span>
    </div>
    <div class="topbar-right">
      <span class="badge">{product.type}</span>
      <span class="price-tag">{product.price}</span>
    </div>
  </div>

  <div class="page-outer">
    <div class="page-doc">
      <div class="doc" set:html={html} />
    </div>
  </div>

  <div class="footer-nav">
    {prev
      ? <a href={`/preview/${prev}`}>← {PRODUCTS[prev].title.split(':')[0]}</a>
      : <span></span>
    }
    <span>{currentIndex + 1} / {allSlugs.length}</span>
    {next
      ? <a href={`/preview/${next}`}>{PRODUCTS[next].title.split(':')[0]} →</a>
      : <span></span>
    }
  </div>

</body>
</html>
