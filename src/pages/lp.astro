---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCaptureForm from '@/components/EmailCaptureForm.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const featuredSlugs = ['negotiation-workbook', '21-scenes', 'brat-playbook'];
const featuredProducts = featuredSlugs
  .map(slug => allProducts.find(product => product.data.slug === slug))
  .filter(Boolean);

export const prerender = true;
---

<BaseLayout
  title="Intentional Intimacy, by Design"
  description="Tension gives couples and singles the language, structure, and consent-first tools to explore power dynamics with care."
  canonical="/lp/"
>
  <main class="lp-shell">
    <section class="lp-hero">
      <img
        src="/images/lp-hero-editorial.png"
        alt="Two adults sitting together with a notebook during a private conversation"
        class="lp-hero-image"
      />
      <div class="lp-hero-overlay"></div>
      <div class="lp-container lp-hero-content">
        <p class="lp-eyebrow">Tension · intentional intimacy</p>
        <h1>The relationship behind the scene.</h1>
        <p class="lp-lede">
          For couples and singles who want more intention, more language, and more trust in the way they explore.
        </p>
        <div class="lp-actions">
          <a class="lp-button lp-button-primary" href="#start">Get the free couples checklist <span aria-hidden="true">→</span></a>
          <a class="lp-button lp-button-quiet" href="#how-it-works">See how Tension works</a>
        </div>
        <p class="lp-note">Private by default · Consent-first · Written for adults</p>
      </div>
    </section>

    <section class="lp-proof" aria-label="Tension principles">
      <div class="lp-container lp-proof-grid">
        <div><strong>Language</strong><span>Say what you want without making it weird.</span></div>
        <div><strong>Structure</strong><span>Turn a fantasy into a conversation and a plan.</span></div>
        <div><strong>Care</strong><span>Keep consent, limits, and aftercare in the frame.</span></div>
      </div>
    </section>

    <section id="how-it-works" class="lp-section lp-section-light">
      <div class="lp-container lp-two-col">
        <div>
          <p class="lp-eyebrow lp-eyebrow-dark">A better starting point</p>
          <h2>You do not need a new identity. You need a clearer conversation.</h2>
        </div>
        <div class="lp-copy">
          <p>Most people find Tension after the search results, the awkward half-conversation, or the moment one partner says: “I want to try something, but I do not know how.”</p>
          <p>Start with the relationship you already have. Explore at the pace that fits your life. Keep what creates connection; leave what does not.</p>
        </div>
      </div>
      <div class="lp-container lp-steps">
        <article><span>01</span><h3>Find the words</h3><p>Use plain-language prompts to name desire, curiosity, limits, and uncertainty.</p></article>
        <article><span>02</span><h3>Build the frame</h3><p>Choose the level of structure, roles, rituals, and safety tools that work for you.</p></article>
        <article><span>03</span><h3>Explore with care</h3><p>Plan a first experiment, keep checking in, and make room for what happens afterward.</p></article>
      </div>
    </section>

    <section id="start" class="lp-start">
      <div class="lp-container lp-start-grid">
        <div>
          <p class="lp-eyebrow">Start with one honest conversation</p>
          <h2>The Couples Kink Discovery Checklist</h2>
          <p class="lp-lede">90 activities across seven categories, with five answers that make “maybe” safe to say.</p>
          <ul class="lp-list">
            <li>Complete it together, not as a test of compatibility.</li>
            <li>Separate curiosity from commitment.</li>
            <li>Use your overlap as a starting point, not a score.</li>
          </ul>
        </div>
        <div class="lp-form-card">
          <p class="lp-form-kicker">Free resource</p>
          <h3>Get the checklist privately.</h3>
          <p>No public profile. No sales call. Just the PDF and a useful place to begin.</p>
          <EmailCaptureForm buttonLabel="Send me the checklist →" />
          <small>We will only email the address you provide. Unsubscribe anytime.</small>
        </div>
      </div>
    </section>

    <section class="lp-section lp-section-dark">
      <div class="lp-container">
        <div class="lp-section-heading">
          <div><p class="lp-eyebrow">Go deeper when you are ready</p><h2>Tools for the dynamic you are building.</h2></div>
          <a href="/#products" class="lp-text-link">Browse all resources <span aria-hidden="true">→</span></a>
        </div>
        <div class="lp-products">
          {featuredProducts.map(product => product && (
            <a class="lp-product" href={`/${product.data.slug}/`}>
              <span class="lp-product-price">{product.data.price_eur ? `€${product.data.price_eur.toFixed(2)}` : 'Free'}</span>
              <h3>{product.data.title}</h3>
              <p>{product.data.tagline}</p>
              <span class="lp-product-link">View resource <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-variations" aria-labelledby="visual-directions">
      <div class="lp-container">
        <p class="lp-eyebrow lp-eyebrow-dark">Visual direction</p>
        <h2 id="visual-directions">Two ways to make the first impression.</h2>
        <p class="lp-variation-intro">The LP currently uses Variation A. Variation B is ready if you want the brand to feel more architectural and symbolic.</p>
        <div class="lp-variation-grid">
          <figure class="lp-variation lp-variation-selected">
            <img src="/images/lp-hero-editorial.png" alt="Editorial variation: two adults sharing a private conversation with a notebook" loading="lazy" />
            <figcaption><strong>A · Editorial intimacy</strong><span>Human, warm, relationship-first. Best for leading with trust and emotional safety.</span><em>Current LP hero</em></figcaption>
          </figure>
          <figure class="lp-variation">
            <img src="/images/lp-hero-structure.png" alt="Abstract variation: cream card, burgundy thread, and black stone on a dark surface" loading="lazy" />
            <figcaption><strong>B · Tactile structure</strong><span>Abstract, private, symbolic. Best for leading with design, rituals, and chosen power.</span><em>Alternate direction</em></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="lp-final">
      <div class="lp-container lp-final-inner">
        <p class="lp-eyebrow">You can start without knowing the label.</p>
        <h2>You only need a next conversation.</h2>
        <a class="lp-button lp-button-primary" href="#start">Get the free checklist <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .lp-shell { background: #0a0a0c; color: #f4f0e8; }
  .lp-container { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
  .lp-hero { position: relative; min-height: min(780px, 88vh); display: flex; align-items: center; overflow: hidden; }
  .lp-hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .lp-hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7,7,9,.98) 0%, rgba(7,7,9,.82) 38%, rgba(7,7,9,.22) 78%, rgba(7,7,9,.5) 100%), linear-gradient(0deg, rgba(7,7,9,.9), transparent 35%); }
  .lp-hero-content { position: relative; z-index: 1; padding-block: 150px 100px; max-width: 1120px; }
  .lp-eyebrow { color: #d4213d; font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }
  .lp-eyebrow-dark { color: #9e2238; }
  .lp-hero h1 { font-family: var(--font-serif); font-size: clamp(3.4rem, 8vw, 7.2rem); line-height: .94; letter-spacing: -.045em; max-width: 10ch; margin: 24px 0; }
  .lp-lede { color: #d2d0ce; font-size: clamp(1.05rem, 2vw, 1.35rem); line-height: 1.65; max-width: 43ch; }
  .lp-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
  .lp-button { display: inline-flex; align-items: center; gap: 12px; padding: 15px 21px; border-radius: 999px; font-size: 13px; font-weight: 700; transition: transform .2s, background .2s, border-color .2s; }
  .lp-button:hover { transform: translateY(-2px); }
  .lp-button-primary { color: #160b0d; background: #f5f0e6; }
  .lp-button-primary:hover { background: #fff; }
  .lp-button-quiet { color: #eee; border: 1px solid rgba(255,255,255,.3); background: rgba(0,0,0,.2); }
  .lp-button-quiet:hover { border-color: rgba(255,255,255,.7); background: rgba(255,255,255,.08); }
  .lp-note { margin-top: 20px; color: #8e8d90; font-size: 12px; }
  .lp-proof { background: #18181c; border-block: 1px solid rgba(255,255,255,.1); }
  .lp-proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .lp-proof-grid div { display: flex; flex-direction: column; gap: 7px; padding: 25px 28px; border-right: 1px solid rgba(255,255,255,.1); }
  .lp-proof-grid div:last-child { border-right: 0; }
  .lp-proof strong { font-family: var(--font-serif); font-size: 20px; }
  .lp-proof span { color: #a9a7a5; font-size: 13px; line-height: 1.5; }
  .lp-section { padding-block: 110px; }
  .lp-section-light, .lp-variations { color: #242126; background: #f1ece3; }
  .lp-section-dark { background: #0e0e11; }
  .lp-two-col { display: grid; grid-template-columns: 1.05fr .95fr; gap: 90px; align-items: start; }
  .lp-section h2, .lp-start h2, .lp-final h2, .lp-variations h2 { font-family: var(--font-serif); font-size: clamp(2.4rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -.035em; margin: 18px 0; }
  .lp-section-light h2, .lp-variations h2 { color: #201e22; }
  .lp-copy { color: #625e59; font-size: 17px; line-height: 1.75; }
  .lp-copy p + p { margin-top: 18px; }
  .lp-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 70px; }
  .lp-steps article { padding: 28px; border-top: 1px solid #c9c0b4; }
  .lp-steps span { color: #a3263d; font-size: 12px; font-weight: 800; letter-spacing: .15em; }
  .lp-steps h3 { color: #201e22; font-family: var(--font-serif); font-size: 25px; margin: 26px 0 9px; }
  .lp-steps p { color: #706a64; line-height: 1.65; font-size: 14px; }
  .lp-start { padding-block: 105px; background: #24151a; }
  .lp-start-grid { display: grid; grid-template-columns: 1fr .85fr; gap: 100px; align-items: center; }
  .lp-start h2 { color: #f7f2e8; max-width: 10ch; }
  .lp-start .lp-lede { color: #d7cfc8; }
  .lp-list { display: grid; gap: 13px; margin-top: 30px; color: #ded4ce; font-size: 14px; }
  .lp-list li { display: flex; gap: 12px; }
  .lp-list li::before { content: '—'; color: #d4213d; }
  .lp-form-card { padding: 38px; border: 1px solid rgba(255,255,255,.15); background: rgba(255,255,255,.06); }
  .lp-form-kicker { color: #d4213d; font-size: 10px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
  .lp-form-card h3 { font-family: var(--font-serif); font-size: 30px; margin: 14px 0 8px; }
  .lp-form-card > p { color: #bcb0ab; line-height: 1.6; font-size: 14px; margin-bottom: 25px; }
  .lp-form-card small { display: block; color: #8f8583; font-size: 11px; line-height: 1.5; margin-top: 13px; }
  .lp-section-heading { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 45px; }
  .lp-section-heading h2 { color: #f4f0e8; max-width: 12ch; }
  .lp-text-link { color: #d4213d; font-size: 13px; font-weight: 700; white-space: nowrap; }
  .lp-products { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .lp-product { display: flex; flex-direction: column; min-height: 285px; padding: 28px; color: #f4f0e8; background: #19191d; border: 1px solid rgba(255,255,255,.1); transition: transform .2s, border-color .2s; }
  .lp-product:hover { transform: translateY(-4px); border-color: rgba(212,33,61,.7); }
  .lp-product-price { color: #d4213d; font-size: 12px; font-weight: 800; letter-spacing: .12em; }
  .lp-product h3 { font-family: var(--font-serif); font-size: 27px; line-height: 1.05; margin: 36px 0 13px; }
  .lp-product p { color: #aaa7a6; line-height: 1.6; font-size: 14px; }
  .lp-product-link { margin-top: auto; padding-top: 25px; color: #eee; font-size: 12px; font-weight: 700; }
  .lp-variations { padding-block: 105px; }
  .lp-variation-intro { max-width: 55ch; color: #6b655e; line-height: 1.65; }
  .lp-variation-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 45px; }
  .lp-variation { margin: 0; border: 1px solid #d0c7bb; background: #e8e1d7; }
  .lp-variation-selected { border-color: #9e2238; box-shadow: 0 0 0 2px rgba(158,34,56,.12); }
  .lp-variation img { display: block; width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .lp-variation figcaption { display: grid; gap: 7px; padding: 21px; }
  .lp-variation strong { font-family: var(--font-serif); font-size: 22px; }
  .lp-variation span { color: #716a63; font-size: 13px; line-height: 1.5; }
  .lp-variation em { color: #9e2238; font-size: 10px; font-style: normal; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .lp-final { padding-block: 105px; background: #08080a; text-align: center; }
  .lp-final-inner { display: flex; flex-direction: column; align-items: center; }
  .lp-final h2 { color: #f4f0e8; max-width: 11ch; }
  @media (max-width: 760px) {
    .lp-container { width: min(100% - 36px, 1120px); }
    .lp-hero { min-height: 730px; align-items: end; }
    .lp-hero-overlay { background: linear-gradient(0deg, rgba(7,7,9,.98) 5%, rgba(7,7,9,.65) 57%, rgba(7,7,9,.2) 100%); }
    .lp-hero-content { padding-block: 70px 55px; }
    .lp-proof-grid, .lp-two-col, .lp-start-grid, .lp-steps, .lp-products, .lp-variation-grid { grid-template-columns: 1fr; }
    .lp-proof-grid div { border-right: 0; border-bottom: 1px solid rgba(255,255,255,.1); }
    .lp-proof-grid div:last-child { border-bottom: 0; }
    .lp-two-col, .lp-start-grid { gap: 38px; }
    .lp-section-heading { align-items: start; flex-direction: column; }
    .lp-section { padding-block: 75px; }
    .lp-start, .lp-variations, .lp-final { padding-block: 75px; }
  }
</style>
