---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EmailCaptureForm from '@/components/EmailCaptureForm.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const allProducts = await getCollection('products');
const product = (slug: string) => allProducts.find(item => item.data.slug === slug);
const guides = [
  {
    slug: 'verbal-arsenal',
    label: 'The Language Field Guide',
    subline: 'Speak clearly. Listen deeply.',
    description: 'Practical language for better conversations, direction, and repair.',
    image: '/images/lp-hero-editorial.png',
  },
  {
    slug: '21-scenes',
    label: 'The Rituals Playbook',
    subline: 'Small rituals. Big results.',
    description: 'Scene blueprints and structures that make trust easier to practice.',
    image: '/images/lp-hero-structure.png',
  },
  {
    slug: 'negotiation-workbook',
    label: 'The Intimacy Workbook',
    subline: 'Explore with care.',
    description: 'Guided exercises for desire, boundaries, agreements, and pleasure.',
    image: '/images/tension_products.png',
  },
].map(guide => ({ ...guide, product: product(guide.slug) }));
---

<BaseLayout
  title="The Relationship Behind the Scene"
  description="Tension gives couples and singles the language, structure, and consent-first tools to explore intentional intimacy with care."
  canonical="/lp/"
>
  <main class="lp-new">
    <nav class="lp-nav" aria-label="Landing page navigation">
      <div class="lp-wrap lp-nav-inner">
        <a class="lp-brand" href="/">TENSION</a>
        <div class="lp-nav-links">
          <a href="/about/">About</a>
          <a href="#approach">Approach</a>
          <a href="#guides">Tools</a>
          <a href="#guides">Guides</a>
          <a href="/blog/">Journal</a>
        </div>
        <a class="lp-nav-cta" href="#checklist">Get the checklist</a>
      </div>
    </nav>

    <section class="lp-new-hero">
      <img src="/images/lp-hero-editorial.png" alt="Two adults sharing a private, quiet conversation" />
      <div class="lp-new-hero-shade"></div>
      <div class="lp-wrap lp-new-hero-copy">
        <p class="lp-kicker">Tension</p>
        <h1>The relationship<br /><em>behind the scene.</em></h1>
        <p class="lp-hero-sub">More <strong>intention.</strong> More <strong>language.</strong> More <strong>trust.</strong></p>
        <div class="lp-new-actions">
          <a class="lp-red-button" href="#checklist">Get the free checklist <span aria-hidden="true">→</span></a>
          <a class="lp-gold-link" href="#approach">See how it works <span aria-hidden="true">→</span></a>
        </div>
        <p class="lp-microcopy">Private by default <span>•</span> Consent-first <span>•</span> Written for adults</p>
      </div>
    </section>

    <section class="lp-principles" aria-label="Tension principles">
      <div class="lp-wrap lp-principle-grid">
        <article><div class="lp-line-icon" aria-hidden="true">▢</div><h2>Language</h2><em>Find the words.</em><p>Name what matters. Speak clearly. Listen deeply.</p></article>
        <article><div class="lp-line-icon" aria-hidden="true">▦</div><h2>Structure</h2><em>Build the frame.</em><p>Create rituals and agreements that hold in real life.</p></article>
        <article><div class="lp-line-icon" aria-hidden="true">♡</div><h2>Care</h2><em>Explore with care.</em><p>Move at a pace that feels safe, curious, and connected.</p></article>
      </div>
    </section>

    <section id="approach" class="lp-approach">
      <div class="lp-wrap">
        <p class="lp-section-label">Our approach</p>
        <h2>A clearer conversation<br /><em>starts here.</em></h2>
        <span class="lp-diamond" aria-hidden="true">◆</span>
        <p class="lp-section-intro">Tools for the relationship you are building.</p>
        <div class="lp-how-grid">
          <article><span>1</span><div><h3>Learn</h3><p>Short, focused guides that teach what works.</p></div></article>
          <div class="lp-arrow" aria-hidden="true">→</div>
          <article><span>2</span><div><h3>Practice</h3><p>Conversation prompts and exercises you can use.</p></div></article>
          <div class="lp-arrow" aria-hidden="true">→</div>
          <article><span>3</span><div><h3>Apply</h3><p>Build habits that create more trust and ease.</p></div></article>
        </div>
      </div>
    </section>

    <section id="checklist" class="lp-checklist">
      <div class="lp-wrap lp-checklist-card">
        <div>
          <p class="lp-section-label">Free resource</p>
          <h2>The Couples Checklist</h2>
          <em>Start with one honest conversation.</em>
          <ul>
            <li>10 conversation starters</li>
            <li>Consent and comfort guide</li>
            <li>Rituals that strengthen connection</li>
            <li>A simple weekly check-in</li>
          </ul>
        </div>
        <div class="lp-checklist-stat"><strong>90</strong><span>SECONDS</span><em>That can change<br />your next talk.</em></div>
        <div class="lp-checklist-form"><EmailCaptureForm buttonLabel="Get the checklist →" /><small>No spam. Unsubscribe anytime.</small></div>
      </div>
    </section>

    <section id="guides" class="lp-guides">
      <div class="lp-wrap">
        <p class="lp-section-label">Guides</p>
        <div class="lp-guide-grid">
          {guides.map(guide => (
            <a class="lp-guide-card" href={`/${guide.slug}/`}>
              <img src={guide.image} alt="" loading="lazy" />
              <div class="lp-guide-shade"></div>
              <div class="lp-guide-copy">
                <h2>{guide.label}</h2>
                <em>{guide.subline}</em>
                <p>{guide.description}</p>
                <span>Learn more <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-direction">
      <div class="lp-wrap">
        <p class="lp-section-label">Our editorial direction</p>
        <div class="lp-direction-grid">
          <a href="/blog/" class="lp-direction-card"><img src="/images/lp-hero-editorial.png" alt="Editorial intimacy: a couple in a quiet private moment" loading="lazy" /><span><strong>Editorial intimacy</strong><em>Real moments. Human stories.</em></span></a>
          <a href="/blog/topic/tools-guides/" class="lp-direction-card"><img src="/images/lp-hero-structure.png" alt="Tactile structure: a card, thread, and stone on a dark surface" loading="lazy" /><span><strong>Tactile structure</strong><em>Beautiful tools. Clear guidance.</em></span></a>
        </div>
      </div>
    </section>

    <section class="lp-new-final">
      <div class="lp-wrap"><h2>You only need<br /><em>a next conversation.</em></h2><a class="lp-red-button" href="#checklist">Get the free checklist <span aria-hidden="true">→</span></a><p class="lp-microcopy">Private by default <span>•</span> Consent-first <span>•</span> Written for adults</p></div>
    </section>
  </main>
</BaseLayout>

<style>
  .lp-new { --gold: #c89219; --gold-bright: #e0a92d; --red: #a31318; --black: #050505; background: var(--black); color: #f5f0e6; min-height: 100vh; }
  .lp-wrap { width: min(1160px, calc(100% - 56px)); margin-inline: auto; }
  .lp-nav { position: absolute; inset: 0 0 auto; z-index: 5; border-bottom: 1px solid rgba(255,255,255,.05); background: rgba(0,0,0,.35); }
  .lp-nav-inner { min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .lp-brand { color: var(--gold-bright); font-family: var(--font-serif); letter-spacing: .25em; font-size: 17px; }
  .lp-nav-links { display: flex; gap: 31px; margin-left: auto; }
  .lp-nav-links a { color: rgba(245,240,230,.82); font-size: 10px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .lp-nav-links a:hover, .lp-gold-link:hover { color: var(--gold-bright); }
  .lp-nav-cta, .lp-red-button { background: var(--red); color: #fff6e8; font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .lp-nav-cta { padding: 14px 24px; }
  .lp-red-button { display: inline-flex; align-items: center; gap: 15px; padding: 16px 23px; }
  .lp-red-button:hover { background: #c01820; }
  .lp-new-hero { position: relative; min-height: 720px; display: flex; align-items: center; overflow: hidden; }
  .lp-new-hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .lp-new-hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0,0,0,.9), rgba(0,0,0,.38) 62%, rgba(0,0,0,.55)), linear-gradient(0deg, rgba(0,0,0,.92), transparent 38%); }
  .lp-new-hero-copy { position: relative; z-index: 1; padding-top: 80px; }
  .lp-kicker, .lp-section-label { color: var(--gold-bright); font-size: 10px; font-weight: 800; letter-spacing: .25em; text-transform: uppercase; }
  .lp-new-hero h1 { font-family: var(--font-serif); font-size: clamp(3.5rem, 7.4vw, 7rem); line-height: .92; letter-spacing: -.045em; margin: 25px 0 22px; max-width: 9ch; }
  .lp-new em { color: var(--gold-bright); font-family: var(--font-serif); font-weight: 400; }
  .lp-hero-sub { font-family: var(--font-serif); font-size: clamp(1.15rem, 2vw, 1.5rem); color: #e1d8c9; }
  .lp-hero-sub strong { color: var(--gold-bright); font-style: italic; font-weight: 400; }
  .lp-new-actions { display: flex; align-items: center; gap: 23px; margin-top: 37px; }
  .lp-gold-link { color: var(--gold-bright); font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .lp-microcopy { color: rgba(245,240,230,.62); font-size: 9px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; margin-top: 33px; }
  .lp-microcopy span { color: var(--gold); padding: 0 8px; }
  .lp-principles { border-block: 1px solid rgba(200,146,25,.48); }
  .lp-principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .lp-principle-grid article { padding: 48px 52px 50px; text-align: center; border-right: 1px solid rgba(200,146,25,.45); }
  .lp-principle-grid article:last-child { border-right: 0; }
  .lp-line-icon { color: var(--gold-bright); font-size: 38px; line-height: 1; margin-bottom: 16px; }
  .lp-principle-grid h2 { font-family: var(--font-serif); font-size: 24px; margin-bottom: 4px; }
  .lp-principle-grid em { font-size: 15px; }
  .lp-principle-grid p { max-width: 185px; color: #aaa19a; font-family: var(--font-serif); font-size: 14px; line-height: 1.45; margin: 15px auto 0; }
  .lp-approach { padding: 94px 0 88px; text-align: center; }
  .lp-approach h2 { font-family: var(--font-serif); font-size: clamp(2.6rem, 5vw, 4.7rem); line-height: .98; margin: 18px 0 20px; }
  .lp-diamond { color: var(--gold); font-size: 9px; display: block; }
  .lp-section-intro { color: #a9a09a; font-family: var(--font-serif); font-size: 16px; margin-top: 14px; }
  .lp-how-grid { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 20px; margin-top: 65px; text-align: left; }
  .lp-how-grid article { display: flex; align-items: start; gap: 20px; }
  .lp-how-grid article > span { color: var(--gold-bright); font-family: var(--font-serif); font-size: 48px; line-height: .8; }
  .lp-how-grid h3 { font-family: var(--font-serif); font-size: 21px; margin-bottom: 7px; }
  .lp-how-grid p { color: #aaa19a; font-family: var(--font-serif); font-size: 13px; line-height: 1.5; }
  .lp-arrow { color: var(--gold); font-size: 27px; }
  .lp-checklist { padding: 0 0 84px; }
  .lp-checklist-card { display: grid; grid-template-columns: 1.15fr .7fr 1fr; align-items: center; gap: 35px; border: 1px solid rgba(200,146,25,.75); padding: 38px 45px; }
  .lp-checklist-card h2 { font-family: var(--font-serif); font-size: 28px; margin: 13px 0 2px; }
  .lp-checklist-card > div:first-child em { font-size: 15px; }
  .lp-checklist-card ul { display: grid; gap: 8px; margin-top: 22px; color: #c2b8ac; font-family: var(--font-serif); font-size: 13px; }
  .lp-checklist-card li::before { content: '✓'; color: var(--gold-bright); margin-right: 9px; }
  .lp-checklist-stat { text-align: center; }
  .lp-checklist-stat strong { display: block; color: var(--gold-bright); font-family: var(--font-serif); font-size: 84px; font-weight: 400; line-height: .85; }
  .lp-checklist-stat span { color: var(--gold-bright); font-size: 14px; letter-spacing: .3em; }
  .lp-checklist-stat em { display: block; margin-top: 16px; font-size: 15px; line-height: 1.25; }
  .lp-checklist-form :global(#email-capture-form) { max-width: none; }
  .lp-checklist-form :global(#email-capture-form input) { background: transparent !important; border: 1px solid rgba(200,146,25,.7) !important; border-right: 1px solid rgba(200,146,25,.7) !important; color: #f5f0e6 !important; }
  .lp-checklist-form :global(#email-capture-form button) { background: var(--red) !important; border-color: var(--red) !important; }
  .lp-checklist-form small { display: block; color: #888078; font-family: var(--font-serif); font-size: 12px; margin-top: 11px; text-align: center; }
  .lp-guides { padding: 0 0 90px; }
  .lp-guides > .lp-wrap > .lp-section-label, .lp-direction .lp-section-label { text-align: center; margin-bottom: 22px; }
  .lp-guide-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .lp-guide-card { position: relative; min-height: 330px; overflow: hidden; border: 1px solid rgba(200,146,25,.75); }
  .lp-guide-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(.6) sepia(.25) brightness(.53); transition: transform .5s; }
  .lp-guide-card:hover img { transform: scale(1.04); }
  .lp-guide-shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.97), rgba(0,0,0,.16) 78%); }
  .lp-guide-copy { position: absolute; inset: auto 24px 24px; }
  .lp-guide-copy h2 { font-family: var(--font-serif); font-size: 24px; margin-bottom: 4px; }
  .lp-guide-copy em { font-size: 14px; }
  .lp-guide-copy p { color: #c4bbb0; font-family: var(--font-serif); font-size: 13px; line-height: 1.45; margin: 13px 0 18px; }
  .lp-guide-copy > span { color: var(--gold-bright); font-size: 10px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .lp-direction { padding: 0 0 86px; }
  .lp-direction-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .lp-direction-card { position: relative; min-height: 220px; overflow: hidden; border: 1px solid rgba(200,146,25,.75); }
  .lp-direction-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: sepia(.2) brightness(.48); }
  .lp-direction-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.9), rgba(0,0,0,.06)); }
  .lp-direction-card > span { position: absolute; z-index: 1; left: 28px; bottom: 25px; display: grid; gap: 3px; }
  .lp-direction-card strong { font-family: var(--font-serif); font-size: 23px; }
  .lp-direction-card em { font-size: 14px; }
  .lp-new-final { border-top: 1px solid rgba(200,146,25,.3); padding: 83px 0 72px; text-align: center; }
  .lp-new-final h2 { font-family: var(--font-serif); font-size: clamp(2.7rem, 5vw, 4.3rem); line-height: .95; margin-bottom: 30px; }
  .lp-new-final .lp-microcopy { margin-top: 27px; }
  @media (max-width: 760px) {
    .lp-wrap { width: min(100% - 36px, 1160px); }
    .lp-nav-inner { min-height: 64px; }
    .lp-nav-links { display: none; }
    .lp-nav-cta { padding: 12px 14px; font-size: 9px; }
    .lp-new-hero { min-height: 690px; align-items: end; }
    .lp-new-hero-copy { padding-bottom: 58px; }
    .lp-new-hero-shade { background: linear-gradient(0deg, rgba(0,0,0,.97), rgba(0,0,0,.55) 62%, rgba(0,0,0,.2)); }
    .lp-new-hero h1 { font-size: clamp(3.2rem, 14vw, 5rem); }
    .lp-new-actions { align-items: start; flex-direction: column; gap: 22px; }
    .lp-principle-grid, .lp-guide-grid, .lp-direction-grid { grid-template-columns: 1fr; }
    .lp-principle-grid article { border-right: 0; border-bottom: 1px solid rgba(200,146,25,.45); }
    .lp-principle-grid article:last-child { border-bottom: 0; }
    .lp-how-grid { grid-template-columns: 1fr; gap: 25px; }
    .lp-arrow { transform: rotate(90deg); margin-left: 23px; }
    .lp-checklist-card { grid-template-columns: 1fr; padding: 29px 24px; text-align: center; }
    .lp-checklist-card ul { text-align: left; width: max-content; max-width: 100%; margin-inline: auto; }
    .lp-checklist-form :global(#email-capture-form > div) { flex-direction: column; gap: 9px; }
    .lp-checklist-form :global(#email-capture-form input) { border-right: 1px solid rgba(200,146,25,.7) !important; }
  }
</style>
